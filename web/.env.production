# Production contract for silverstone-ai.com — used by `npm run build:production`
# (the Netlify build). parsePublicEnvironment validates these exact values;
# anything else fails closed to the staging rules.
VITE_STAGING_MODE=false
VITE_ANALYTICS_DISABLED=true
VITE_ROBOTS_META=index,follow
VITE_X_ROBOTS_TAG=all
VITE_SITE_URL=https://silverstone-ai.com
VITE_CANONICAL_ORIGIN=https://silverstone-ai.com
VITE_BOOKING_MODE=live
VITE_INDEXNOW_DISABLED=true

# No secrets belong in this file. RESEND_API_KEY and the contact-address
# overrides live in the Netlify site environment and are read exclusively by
# netlify/functions/send-email.js at request time.
