90":146,"_129":228,"_162":229},{"_174":175,"_127":149,"_129":224,"_177":225,"_162":226},{"_174":175,"_127":146,"_129":220,"_177":221,"_162":222},"Do not give exercise, injury or health advice through general automation. Avoid unverified transformation claims and pressure-based messaging.",[223],"[data-approved-section=\"4-paragraph-2\"]",{"_174":129,"_182":220},"Best suited to an operator with clean membership data, a defined trial journey and an owner for consent and suppression rules.",[227],"[data-approved-section=\"4-paragraph-1\"]",{"_174":129,"_182":224},"Qualification and safeguard","[data-approved-section=\"4-heading\"]","[data-approved-section=\"3\"]",[193],{"_190":146,"_129":266},[234,235],{"_174":167,"_127":152,"_190":146,"_129":266,"_162":267},{"_174":200,"_127":149,"_201":135,"_202":236,"_162":237},[238,239,240,241,242,243,244],"[data-approved-section=\"3-list\"]",{"_129":263,"_177":264},{"_129":260,"_177":261},{"_129":257,"_177":258},{"_129":254,"_177":255},{"_129":251,"_177":252},{"_129":248,"_177":249},{"_129":245,"_177":246},"What evidence will show whether the first release is useful",[247],{"_174":129,"_182":245},"How consent, retention and access will be managed",[250],{"_174":129,"_182":248},"Who owns failed or incomplete handoffs",[253],{"_174":129,"_182":251},"Which questions or events require a person",[256],{"_174":129,"_182":254},"Which actions can happen automatically",[259],{"_174":129,"_182":257},"The minimum information needed at the first step",[262],{"_174":129,"_182":260},"The source of truth for availability, customer status and records",[265],{"_174":129,"_182":263},"What to define before build","[data-approved-section=\"3-heading\"]","[data-approved-section=\"2\"]",[193],{"_190":146,"_129":278},[272,273],{"_174":167,"_127":152,"_190":146,"_129":278,"_162":279},{"_174":175,"_127":149,"_129":274,"_177":275,"_162":276},"A trial lead chooses a location or class type, receives the correct booking path, has consent and preferences recorded, and enters an approved follow-up sequence. Membership disputes, injuries and sensitive issues return to staff. This is an example workflow only. It is not a client case study, measured result or contractual promise.",[277],"[data-approved-section=\"2-paragraph-1\"]",{"_174":129,"_182":274},"Illustrative workflow","[data-approved-section=\"2-heading\"]","[data-approved-section=\"1\"]",[193],{"_190":146,"_129":300},[284,285],{"_174":167,"_127":152,"_190":146,"_129":300,"_162":301},{"_174":200,"_127":149,"_201":135,"_202":286,"_162":287},[288,289,290,291],"[data-approved-section=\"1-list\"]",{"_129":153,"_177":298},{"_129":150,"_177":296},{"_129":147,"_177":294},{"_129":144,"_177":292},[293],{"_174":184,"_129":144,"_185":145,"_131":145,"_134":135,"_136":38},[295],{"_174":184,"_129":147,"_185":148,"_131":148,"_134":135,"_136":38},[297],{"_174":184,"_129":150,"_185":151,"_131":151,"_134":135,"_136":38},[299],{"_174":184,"_129":153,"_185":154,"_131":154,"_134":135,"_136":38},"Relevant service combinations","[data-approved-section=\"1-heading\"]","[data-approved-section=\"0\"]",[193],{"_190":146,"_129":326},[306,307],{"_174":167,"_127":152,"_190":146,"_129":326,"_162":327},{"_174":200,"_127":149,"_201":135,"_202":308,"_162":309},[310,311,312,313],"[data-approved-section=\"0-list\"]",{"_129":323,"_177":324},{"_129":320,"_177":321},{"_129":317,"_177":318},{"_129":314,"_177":315},"Generic promotions can feel impersonal",[316],{"_174":129,"_182":314},"Inactive members are difficult to segment consistently",[319],{"_174":129,"_182":317},"Waitlists and cancellations need prompt updates",[322],{"_174":129,"_182":320},"Trial enquiries arrive through several channels",[325],{"_174":129,"_182":323},"Where friction tends to appear","[data-approved-section=\"0-heading\"]",{"_127":152,"_190":149,"_129":34},{"_127":149,"_190":146,"_129":326},{"_127":146,"_190":146,"_129":326},{"_127":143,"_190":146,"_129":300},{"_127":140,"_190":146,"_129":300},{"_127":137,"_190":146,"_129":278},{"