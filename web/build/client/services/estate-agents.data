":146,"_132":146,"_135":136,"_137":38},"Related insights","[data-approved-section=\"5-heading\"]","[data-approved-section=\"4\"]",[197],{"_194":150,"_130":235},[224,225,226],{"_178":171,"_128":156,"_194":150,"_130":235,"_166":236},{"_178":179,"_128":153,"_130":231,"_181":232,"_166":233},{"_178":179,"_128":150,"_130":227,"_181":228,"_166":229},"Do not automate final suitability decisions, financial advice, complaint resolution or any communication that requires professional judgement.",[230],"[data-approved-section=\"4-paragraph-2\"]",{"_178":130,"_186":227},"Best suited to an agency with repeat enquiry volume, an agreed CRM or diary owner, and a manager willing to define qualification and escalation rules.",[234],"[data-approved-section=\"4-paragraph-1\"]",{"_178":130,"_186":231},"Qualification and safeguard","[data-approved-section=\"4-heading\"]","[data-approved-section=\"3\"]",[197],{"_194":150,"_130":273},[241,242],{"_178":171,"_128":156,"_194":150,"_130":273,"_166":274},{"_178":204,"_128":153,"_205":136,"_206":243,"_166":244},[245,246,247,248,249,250,251],"[data-approved-section=\"3-list\"]",{"_130":270,"_181":271},{"_130":267,"_181":268},{"_130":264,"_181":265},{"_130":261,"_181":262},{"_130":258,"_181":259},{"_130":255,"_181":256},{"_130":252,"_181":253},"What evidence will show whether the first release is useful",[254],{"_178":130,"_186":252},"How consent, retention and access will be managed",[257],{"_178":130,"_186":255},"Who owns failed or incomplete handoffs",[260],{"_178":130,"_186":258},"Which questions or events require a person",[263],{"_178":130,"_186":261},"Which actions can happen automatically",[266],{"_178":130,"_186":264},"The minimum information needed at the first step",[269],{"_178":130,"_186":267},"The source of truth for availability, customer status and records",[272],{"_178":130,"_186":270},"What to define before build","[data-approved-section=\"3-heading\"]","[data-approved-section=\"2\"]",[197],{"_194":150,"_130":285},[279,280],{"_178":171,"_128":156,"_194":150,"_130":285,"_166":286},{"_178":179,"_128":153,"_130":281,"_181":282,"_166":283},"A valuation request is captured, the owner’s property and timing are recorded, the lead is routed to the right branch, a viewing or callback is requested, and the negotiator receives a structured summary. Complaints, safeguarding issues and unusual cases go directly to a person. This is an example workflow only. It is not a client case study, measured result or contractual promise.",[284],"[data-approved-section=\"2-paragraph-1\"]",{"_178":130,"_186":281},"Illustrative workflow","[data-approved-section=\"2-heading\"]","[data-approved-section=\"1\"]",[197],{"_194":150,"_130":307},[291,292],{"_178":171,"_128":156,"_194":150,"_130":307,"_166":308},{"_178":204,"_128":153,"_205":136,"_206":293,"_166":294},[295,296,297,298],"[data-approved-section=\"1-list\"]",{"_130":157,"_181":305},{"_130":154,"_181":303},{"_130":151,"_181":301},{"_130":148,"_181":299},[300],{"_178":188,"_130":148,"_189":149,"_132":149,"_135":136,"_137":38},[302],{"_178":188,"_130":151,"_189":152,"_132":152,"_135":136,"_137":38},[304],{"_178":188,"_130":154,"_189":155,"_132":155,"_135":136,"_137":38},[306],{"_178":188,"_130":157,"_189":158,"_132":158,"_135":136,"_137":38},"Relevant service combinations","[data-approved-section=\"1-heading\"]","[data-approved-section=\"0\"]",[197],{"_194":150,"_130":333},[313,314],{"_178":171,"_128":156,"_194":150,"_130":333,"_166":334},{"_178":204,"_128":153,"_205":136,"_206":315,"_166":316},[317,318,319,320],"[data-approved-section=\"0-list\"]",{"_130":330,"_181":331},{"_130":327,"_181":328},{"_130":324,"_181":325},{"_130":321,"_181":322},"Information is copied between inboxes, calendars and the CRM",[323],{"_178":130,"_186":321},"Viewing confirmations and feedback are easy to chase inconsistently",[326],{"_178":130,"_186":324},"Buyer, seller, landlord and tenant leads need different questions",[329],{"_178":130,"_186":327},"Enquiries arrive while negotiators ar