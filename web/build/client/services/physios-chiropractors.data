83,"_13":14},"name","Physios & Chiropractors","Services","/services","Home","/","h1Source","A-01 route inventory","supportingHeadingsStatus","pending content migration","routeId","routePath","kind","source",{"_635":12,"_636":47,"_637":638,"_639":640,"_641":642,"_643":644},"metadata",{"_29":30,"_31":32,"_15":16,"_595":596,"_597":-5,"_598":599,"_600":601,"_602":603},"schema",[500,501],"headings",[480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499],"sections",[116,117,118,119,120,121,122,123,124],"links",[],"assets",[],"interactions",[],"flags",{"_54":28,"_55":56,"_113":114,"_69":115},"riskNotes","5 images lack width/height; quantified or absolute proof claims require substantiation",[],{"_125":448,"_127":449,"_129":-5,"_130":450,"_132":451,"_134":452},{"_125":412,"_127":184,"_129":-5,"_130":413,"_132":414,"_134":415},{"_125":177,"_127":315,"_129":-5,"_130":373,"_132":374,"_134":375},{"_125":352,"_127":184,"_129":-5,"_130":362,"_132":363,"_134":364},{"_125":244,"_127":315,"_129":-5,"_130":316,"_132":317,"_134":318},{"_125":271,"_127":184,"_129":-5,"_130":272,"_132":273,"_134":274},{"_125":225,"_127":184,"_129":-5,"_130":226,"_132":227,"_134":228},{"_125":183,"_127":184,"_129":-5,"_130":185,"_132":186,"_134":187},{"_125":126,"_127":128,"_129":-5,"_130":131,"_132":133,"_134":135},"order",9,"sourceSelector","section.section.brand-gradient.animate","sourceId","sourceClasses",[180,181,182],"heading",{"_176":177,"_146":178},"blocks",[136,137,138,139,140,141,142],{"_143":132,"_125":175,"_176":177,"_146":178,"_127":179},{"_143":144,"_125":170,"_146":171,"_148":172,"_127":173},{"_143":144,"_125":166,"_146":167,"_148":168,"_127":156},{"_143":144,"_125":162,"_146":163,"_148":164,"_127":156},{"_143":144,"_125":158,"_146":159,"_148":160,"_127":156},{"_143":144,"_125":153,"_146":154,"_148":155,"_127":156},{"_143":144,"_125":145,"_146":147,"_148":149,"_127":150},"type","paragraph",56,"text","Book my free clinic automation audit","segments",[151],"a.btn.btn-primary",{"_143":146,"_152":147},"value",55,"Read the rebooking guide",[157],"a",{"_143":146,"_152":154},54,"Read the clinic automation guide",[161],{"_143":146,"_152":159},53,"See clinic pricing",[165],{"_143":146,"_152":163},52,"Browse all Silverstone AI services",[169],{"_143":146,"_152":167},51,"DNAs, messy intake, and patchy follow-up cost clinics both capacity and outcomes. The ‘Smart Intake & Rebooking Hub’ shows how to fix that around your current systems.",[174],"p.section-subtitle",{"_143":146,"_152":171},50,"level",2,"Ready to reduce DNAs and fill more appointments?","h2.section-title","section","brand-gradient","animate",8,"section.section.bg-lines.animate",[180,222,182,223,224],{"_176":177,"_146":221},[188,189,190,191,192,193,194],{"_143":132,"_125":220,"_176":177,"_146":221,"_127":179},{"_143":144,"_125":216,"_146":217,"_148":218,"_127":198},{"_143":144,"_125":212,"_146":213,"_148":214,"_127":198},{"_143":144,"_125":208,"_146":209,"_148":210,"_127":198},{"_143":144,"_125":204,"_146":205,"_148":206,"_127":198},{"_143":144,"_125":200,"_146":201,"_148":202,"_127":198},{"_143":144,"_125":195,"_146":196,"_148":197,"_127":198},49,"Yes. Many clinics prefer to start with one service or location, demonstrate value and then expand gradually.",[199],"p",{"_143":146,"_152":196},48,"The aim is to reduce workload by taking repetitive tasks away. Clinicians may spend a small amount of time upfront agreeing wording, but day-to-day the system should free time, not consume it.",[203],{"_143":146,"_152":201},47,"Clinicians can choose to adjust or pause automation for individual patients. The system is there to handle typical scenarios, not override clinical judgement.",[207],{"_143":146,"_152":205},46,"We use clear, professional language that supports rather than alarms patients. Clinicians and practice managers review and approve content before it is used.",[211],{"_143":146,"_152":209},45,"Yes. We work with you to ensure automation respects your existing data-protection processes. Only the information needed for communication and booking is used, and you decide how long it is retained.",[215],{"_143":146,"_152":213},44,"No. The hub is designed to sit alongside your existing software, not replace it. Where possible we connect directly so that appointments and records stay in one source of truth.",[219],{"_143":146,"_152":217},43,"Clinic Automation FAQs","bg-lines","parallax-section","compact-section",6,[180,222,182,223,224],{"_176":177,"_146":270},[229,230,231,232,233,234,235,236,237,238],{"_143":132,"_125":269,"_176":177,"_146":270,"_127":179},{"_143":144,"_125":265,"_146":266,"_148":267,"_127":173},{"_143":132,"_125":263,"_176":244,"_146":264,"_127":246},{"_143":144,"_125":259,"_146":260,"_148":261,"_127":198},{"_143":132,"_125":257,"_176":244,"_146":258,"_127":246},{"_143":144,"_125":253,"_146":254,"_148":255,"_127":198},{"_143":132,"_125":251,"_176":244,"_146":252,"_127":246},{"_143":144,"_125":247,"_146":248,"_148":249,"_127":198},{"_143":132,"_125":243,"_176":244,"_146":245,"_127":246},{"_143":144,"_125":239,"_146":240,"_148":241,"_127":198},42,"Transparent setup and support so you know exactly what will change before anything goes live.",[242],{"_143":146,"_152":240},41,4,"Transparent setup and support","h4",40,"Clinicians retain control over treatment plans and can override or pause automations for individual cases.",[250],{"_143":146,"_152":248},39,"Clinician control stays central",38,"Patients receive clear, supportive communication in plain language – never pushy or technical.",[256],{"_143":146,"_152":254},37,"Plain-language, supportive communication",36,"We work within the permissions and data-protection settings that your clinic already follows.",[262],{"_143":146,"_152":260},35,"Aligned with your data-protection settings",34,"Protect patient experience and clinician control while improving attendance.",[268],{"_143":146,"_152":266},33,"Supportive messaging, privacy-aware by design",5,[180,222,182,223,224],{"_176":177,"_146":314},[275,276,277,278,279,280,281,282,283,284],{"_143":132,"_125":313,"_176":177,"_146":314,"_127":179},{"_143":144,"_125":309,"_146":310,"_148":311,"_127":173},{"_143":132,"_125":307,"_176":244,"_146":308,"_127":246},{"_143":144,"_125":303,"_146":304,"_148":305,"_127":198},{"_143":132,"_125":301,"_176":244,"_146":302,"_127":246},{"_143":144,"_125":297,"_146":298,"_148":299,"_127":198},{"_143":132,"_125":295,"_176":244,"_146":296,"_127":246},{"_143":144,"_125":291,"_146":292,"_148":293,"_127":198},{"_143":132,"_125":289,"_176":244,"_146":290,"_127":246},{"_143":144,"_125":285,"_146":286,"_148":287,"_127":198},32,"Expand to the wider patient base, then adjust language and timings as you see results.",[288],{"_143":146,"_152":286},31,"Roll out and refine",30,"Link automations to your practice-management system or booking tools and test with a small group of patients.",[294],{"_143":146,"_152":292},29,"Connect and test",28,"Agree which forms, reminders and follow-ups should exist for each service type.",[300],{"_143":146,"_152":298},27,"Design intake and rebooking journeys",26,"Understand your current booking process, systems and pain points.",[306],{"_143":146,"_152":304},25,"Quick automation audit",24,"Respect clinical workflows, integrate where possible, and iterate based on results.",[312],{"_143":146,"_152":310},23,"Clinic-friendly setup in four steps","section.section.bg-circuit.animate",[180,361,182,223,224],{"_176":177,"_146":360},[319,320,321,322,323],{"_143":132,"_125":359,"_176":177,"_146":360,"_127":179},{"_143":144,"_125":355,"_146":356,"_148":357,"_127":173},{"_143":132,"_125":351,"_176":352,"_146":353,"_127":354},{"_143":144,"_125":347,"_146":348,"_148":349,"_127":198},{"_143":324,"_125":325,"_326":327,"_328":329,"_127":330},"list",22,"ordered",false,"items",[331,332,333,334],"ul",{"_146":344,"_148":345},{"_146":341,"_148":342},{"_146":338,"_148":339},{"_146":335,"_148":336},"Teams get clearer visibility on active, drifting, and lapsed patients.",[337],{"_143":146,"_152":335},"More patients understand and complete their treatment plan.",[340],{"_143":146,"_152":338},"Clinicians start with the right information already captured.",[343],{"_143":146,"_152":341},"Fewer no-shows and short-notice cancellations.",[346],{"_143":146,"_152":344},21,"Reduce DNAs, improve preparation, and keep treatment plans moving with less admin.",[350],{"_143":146,"_152":348},20,3,"Support outcomes and utilisation","h3",19,"Help patients show up prepared and stay on track, while reducing admin for clinicians and reception.",[358],{"_143":146,"_152":356},18,"Better attendance, clearer plans","bg-circuit",[180,222,182,223,224],{"_176":177,"_146":372},[365,366],{"_143":132,"_125":371,"_176":177,"_146":372,"_127":179},{"_143":144,"_125":367,"_146":368,"_148":369,"_127":173},17,"Small improvements in attendance add up to meaningful capacity over the year.",[370],{"_143":146,"_152":368},16,"No-shows reduce capacity and continuity",[180,361,182,223,224],{"_176":177,"_146":410},[376,377,378,379,380],{"_143":132,"_125":409,"_176":177,"_146":410,"_127":411},{"_143":144,"_125":405,"_146":406,"_148":407,"_127":173},{"_143":132,"_125":403,"_176":352,"_146":404,"_127":354},{"_143":144,"_125":399,"_146":400,"_148":401,"_127":198},{"_143":324,"_125":381,"_326":327,"_328":382,"_127":330},15,[383,384,385,386],{"_146":396,"_148":397},{"_146":393,"_148":394},{"_146":390,"_148":391},{"_146":387,"_148":388},"Rebooking nudges that keep treatment plans moving.",[389],{"_143":146,"_152":387},"Reminders with prep guidance and easy reschedule options.",[392],{"_143":146,"_152":390},"Triage questions that steer patients to the right clinician or service.",[395],{"_143":146,"_152":393},"Digital intake forms that go out as soon as a patient books.",[398],{"_143":146,"_152":396},14,"This clinic-ready bundle tightens pre-visit prep, reminders, and follow-up without changing your care model.",[402],{"_143":146,"_152":400},13,"Intake and rebooking in sync",12,"Clinic-ready automations that streamline intake, reduce no-shows and keep patients moving through treatment plans.",[408],{"_143":146,"_152":406},11,"The ‘Smart Intake & Rebooking Hub’","h2#smart-intake-rebooking-hub",1,[180,222,182,223,224],{"_176":177,"_146":447},[416,417,418,419,420],{"_143":132,"_125":225,"_176":177,"_146":447,"_127":179},{"_143":144,"_125":443,"_146":444,"_148":445,"_127":173},{"_143":132,"_125":183,"_176":352,"_146":442,"_127":354},{"_143":144,"_125":126,"_146":439,"_148":440,"_127":198},{"_143":324,"_125":421,"_326":327,"_328":422,"_127":330},10,[423,424,425,426],{"_146":436,"_148":437},{"_146":433,"_148":434},{"_146":430,"_148":431},{"_146":427,"_148":428},"Patients drop off plan when next steps are not reinforced clearly.",[429],{"_143":146,"_152":427},"Clinicians lose time chasing rebookings and basic questions.",[432],{"_143":146,"_152":430},"No-shows and short-notice cancellations leave hard-to-fill gaps.",[435],{"_143":146,"_152":433},"New patients arrive without forms or the right prep.",[438],{"_143":146,"_152":436},"When intake, reminders, and rebooking are inconsistent, diaries open up and patients drift off plan.",[441],{"_143":146,"_152":439},"Where clinic time leaks.",7,"Streamlined intake and consistent follow-up keep patients prepared, on plan, and more likely to attend.",[446],{"_143":146,"_152":444},"Less chasing. Better attendance.",0,"section.hero.title-band",[478,479],{"_176":412,"_146":34},[453,454,455,456,457,458],{"_143":144,"_125":448,"_146":86,"_148":476,"_127":474},{"_143":144,"_125":412,"_146":84,"_148":473,"_127":474},{"_143":144,"_125":177,"_146":470,"_148":471,"_127":198},{"_143":144,"_125":352,"_146":466,"_148":467,"_127":468},{"_143":144,"_125":244,"_146":463,"_148":464,"_127":150},{"_143":144,"_125":271,"_146":459,"_148":460,"_127":461},"See the ‘Smart Intake & Rebooking Hub’",[462],"a.btn.btn-secondary",{"_143":146,"_152":459},"Book a free clinic automation audit",[465],{"_143":146,"_152":463},"Typical fit: clinics balancing intake, diary gaps, care-plan follow-up, and practitioner admin.",[469],"p.hero-context",{"_143":146,"_152":466},"A smart intake and rebooking hub that reduces no-shows, tidies paperwork, and keeps patients on plan.",[472],{"_143":146,"_152":470},[475],"a.hero-breadcrumb__link",{"_143":146,"_152":84},[477],{"_143":146,"_152":86},"hero","title-band",{"_125":448,"_176":412,"_146":34},{"_125":412,"_176":177,"_146":447},{"_125":177,"_176":352,"_146":442},{"_125":352,"_176":177,"_146":410},{"_125":244,"_176":352,"_146":404},{"_125":271,"_176":177,"_146":372},{"_125":225,"_176":177,"_146":360},{"_125":443,"_176":352,"_146":353},{"_125":183,"_176":177,"_146":314},{"_125":126,"_176":244,"_146":308},{"_125":421,"_176":244,"_146":302},{"_125":409,"_176":244,"_146":296},{"_125":405,"_176":244,"_146":290},{"_125":403,"_176":177,"_146":270},{"_125":399,"_176":244,"_146":264},{"_125":381,"_176":244,"_146":258},{"_125":371,"_176":244,"_146":252},{"_125":367,"_176":244,"_146":245},{"_125":359,"_176":177,"_146":221},{"_125":355,"_176":177,"_146":178},{"_125":448,"_502":535,"_504":536,"_506":537},{"_125":412,"_502":503,"_504":505,"_506":507},"types",[511,520,524],"rawJson","{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"FAQPage\",\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Will this replace our practice-management system?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"No. The hub is designed to sit alongside your existing software, not replace it. Where possible we connect directly so that appointments and records stay in one source of truth.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Is patient data handled safely?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. We work with you to ensure automation respects your existing data-protection processes. Only the information needed for communication and booking is used, and you decide how long it is retained.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How do we make sure messages feel appropriate for clinical settings?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"We use clear, professional language that supports rather than alarms patients. Clinicians and practice managers review and approve content before it is used.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What if a patient has complex needs and standard journeys are not appropriate?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Clinicians can choose to adjust or pause automation for individual patients. The system is there to handle typical scenarios, not override clinical judgement.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Does this increase workload for clinicians?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"The aim is to reduce workload by taking repetitive tasks away. Clinicians may spend a small amount of time upfront agreeing wording, but day-to-day the system should free time, not consume it.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Can we start with one service line or site first?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. Many clinics prefer to start with one service or location, demonstrate value and then expand gradually.\"\n        }\n      }\n    ]\n  }","parsed",{"_508":509,"_510":511,"_512":513},"@context","https://schema.org","@type","FAQPage","mainEntity",[514,515,516,517,518,519],{"_510":520,"_82":533,"_522":534},{"_510":520,"_82":531,"_522":532},{"_510":520,"_82":529,"_522":530},{"_510":520,"_82":527,"_522":528},{"_510":520,"_82":525,"_522":526},{"_510":