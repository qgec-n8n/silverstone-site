[{"_1":2},"../routes/industries/industry",{"_3":4},"data",{"_5":6,"_7":8},"content",{"_9":45,"_92":10,"_93":14,"_94":20,"_95":96,"_97":98,"_99":100,"_101":102,"_103":104,"_105":106,"_107":108,"_109":110,"_111":112},"route",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":38,"_40":41,"_42":43,"_44":45,"_46":47,"_48":49,"_50":51,"_52":53,"_54":28,"_55":56,"_57":58,"_59":60,"_61":62,"_63":64,"_65":66,"_67":68,"_69":70},"id","route-services-dentists","legacyRouteKey","canonical:/services/dentists","path","/services/dentists","canonical","https://silverstone-ai.com/services/dentists","routeGroup","industries","template","industry","lifecycle","retained","legacyDisposition","retain","implementationDisposition","refactor","contentDisposition","rewrite","title","AI Automation for Dentists | Silverstone AI","description","Silverstone AI helps UK dental practices automate recall, reduce DNAs, and keep treatment books full with practical AI follow-up.","h1","Dentists: never let recall slip through the cracks.","headingPlan",{"_33":34,"_88":89,"_90":91},"productionIndexable",true,"sitemap","breadcrumbs",[79,80,81],"schemaTypes",[77,78],"contentId","content-services-dentists","sourceFile","services/dentists.html","sourcePath","/services/dentists.html","migrationOwner","Codex route migration","contentOwner","Silverstone editorial review","contentStatus","claimsStatus","evidence-pending","primaryIntent","industry service discovery","ctaIntent","pricing or booking","parentRouteId","route-services","relatedRouteIds",[62,75,76],"migrationEvidence","repository evidence + live HTTP + live browser","acceptanceIds",[71,72,73,74],"unresolvedNotes",[],"AC-003","AC-004","AC-006","AC-007","route-pricing","route-book","Service","BreadcrumbList",{"_82":86,"_13":87},{"_82":84,"_13":85},{"_82":83,"_13":14},"name","Dentists","Services","/services","Home","/","h1Source","A-01 route inventory","supportingHeadingsStatus","pending content migration","routeId","routePath","kind","source",{"_635":12,"_636":47,"_637":638,"_639":640,"_641":642,"_643":644},"metadata",{"_29":30,"_31":32,"_15":16,"_595":596,"_597":-5,"_598":599,"_600":601,"_602":603},"schema",[500,501],"headings",[480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499],"sections",[116,117,118,119,120,121,122,123,124],"links",[],"assets",[],"interactions",[],"flags",{"_54":28,"_55":56,"_113":114,"_69":115},"riskNotes","5 images lack width/height; quantified or absolute proof claims require substantiation",[],{"_125":448,"_127":449,"_129":-5,"_130":450,"_132":451,"_134":452},{"_125":412,"_127":184,"_129":-5,"_130":413,"_132":414,"_134":415},{"_125":177,"_127":315,"_129":-5,"_130":373,"_132":374,"_134":375},{"_125":352,"_127":184,"_129":-5,"_130":362,"_132":363,"_134":364},{"_125":244,"_127":315,"_129":-5,"_130":316,"_132":317,"_134":318},{"_125":271,"_127":184,"_129":-5,"_130":272,"_132":273,"_134":274},{"_125":225,"_127":184,"_129":-5,"_130":226,"_132":227,"_134":228},{"_125":183,"_127":184,"_129":-5,"_130":185,"_132":186,"_134":187},{"_125":126,"_127":128,"_129":-5,"_130":131,"_132":133,"_134":135},"order",9,"sourceSelector","section.section.brand-gradient.animate","sourceId","sourceClasses",[180,181,182],"heading",{"_176":177,"_146":178},"blocks",[136,137,138,139,140,141,142],{"_143":132,"_125":175,"_176":177,"_146":178,"_127":179},{"_143":144,"_125":170,"_146":171,"_148":172,"_127":173},{"_143":144,"_125":166,"_146":167,"_148":168,"_127":156},{"_143":144,"_125":162,"_146":163,"_148":164,"_127":156},{"_143":144,"_125":158,"_146":159,"_148":160,"_127":156},{"_143":144,"_125":153,"_146":154,"_148":155,"_127":156},{"_143":144,"_125":145,"_146":147,"_148":149,"_127":150},"type","paragraph",56,"text","Book my free dental automation audit","segments",[151],"a.btn.btn-primary",{"_143":146,"_152":147},"value",55,"Read the dental recall guide",[157],"a",{"_143":146,"_152":154},54,"Read the missed-call recovery guide",[161],{"_143":146,"_152":159},53,"See dental pricing",[165],{"_143":146,"_152":163},52,"Browse all Silverstone AI services",[169],{"_143":146,"_152":167},51,"Recall gaps, hygiene DNAs, and overdue patients quietly drain chair time. The ‘Recall & Hygiene Booster’ shows how to fix that with the systems you already use.",[174],"p.section-subtitle",{"_143":146,"_152":171},50,"level",2,"Ready to keep more chairs consistently full?","h2.section-title","section","brand-gradient","animate",8,"section.section.bg-lines.animate",[180,222,182,223,224],{"_176":177,"_146":221},[188,189,190,191,192,193,194],{"_143":132,"_125":220,"_176":177,"_146":221,"_127":179},{"_143":144,"_125":216,"_146":217,"_148":218,"_127":198},{"_143":144,"_125":212,"_146":213,"_148":214,"_127":198},{"_143":144,"_125":208,"_146":209,"_148":210,"_127":198},{"_143":144,"_125":204,"_146":205,"_148":206,"_127":198},{"_143":144,"_125":200,"_146":201,"_148":202,"_127":198},{"_143":144,"_125":195,"_146":196,"_148":197,"_127":198},49,"Yes. Many practices begin with hygiene recall or a specific patient group, prove the benefit and then expand gradually to wider recall.",[199],"p",{"_143":146,"_152":196},48,"The system is designed to be measured and respectful. We agree sensible limits on how often patients can be contacted and ensure messages add value rather than noise.",[203],{"_143":146,"_152":201},47,"Clinical decisions remain with your dental team. Automation helps deliver agreed recall schedules but does not decide who needs what care. We work with clinical leads to ensure messaging supports, rather than replaces, clinical judgement.",[207],{"_143":146,"_152":205},46,"Yes. We can create different recall rules and messaging for different patient groups, so you can respect contractual and clinical differences while still benefiting from automation.",[211],{"_143":146,"_152":209},45,"We use the consent status and preferences recorded in your system as the starting point. Patients who opt out of certain channels are respected, and you can choose which groups receive which messages.",[215],{"_143":146,"_152":213},44,"In most cases we connect to, or work alongside, your current practice-management system. The goal is to make better use of the data you already hold rather than introduce yet another platform.",[219],{"_143":146,"_152":217},43,"Dental Automation FAQs","bg-lines","parallax-section","compact-section",6,[180,222,182,223,224],{"_176":177,"_146":270},[229,230,231,232,233,234,235,236,237,238],{"_143":132,"_125":269,"_176":177,"_146":270,"_127":179},{"_143":144,"_125":265,"_146":266,"_148":267,"_127":173},{"_143":132,"_125":263,"_176":244,"_146":264,"_127":246},{"_143":144,"_125":259,"_146":260,"_148":261,"_127":198},{"_143":132,"_125":257,"_176":244,"_146":258,"_127":246},{"_143":144,"_125":253,"_146":254,"_148":255,"_127":198},{"_143":132,"_125":251,"_176":244,"_146":252,"_127":246},{"_143":144,"_125":247,"_146":248,"_148":249,"_127":198},{"_143":132,"_125":243,"_176":244,"_146":245,"_127":246},{"_143":144,"_125":239,"_146":240,"_148":241,"_127":198},42,"Set-up is documented so you can evidence how recall and reminders are being managed.",[242],{"_143":146,"_152":240},41,4,"Documented set-up","h4",40,"Practices retain control over which patients are contacted, how often and through which channels.",[250],{"_143":146,"_152":248},39,"Practice control over outreach",38,"Messages are written in plain, reassuring language and reviewed with clinical leads.",[256],{"_143":146,"_152":254},37,"Reassuring, plain language",36,"We work within your existing consent processes and respect patients’ communication preferences.",[262],{"_143":146,"_152":260},35,"Consent and preferences respected",34,"Measured messaging that respects preferences, oversight and compliance.",[268],{"_143":146,"_152":266},33,"Consent-aware, clinically reviewed",5,[180,222,182,223,224],{"_176":177,"_146":314},[275,276,277,278,279,280,281,282,283,284],{"_143":132,"_125":313,"_176":177,"_146":314,"_127":179},{"_143":144,"_125":309,"_146":310,"_148":311,"_127":173},{"_143":132,"_125":307,"_176":244,"_146":308,"_127":246},{"_143":144,"_125":303,"_146":304,"_148":305,"_127":198},{"_143":132,"_125":301,"_176":244,"_146":302,"_127":246},{"_143":144,"_125":297,"_146":298,"_148":299,"_127":198},{"_143":132,"_125":295,"_176":244,"_146":296,"_127":246},{"_143":144,"_125":291,"_146":292,"_148":293,"_127":198},{"_143":132,"_125":289,"_176":244,"_146":290,"_127":246},{"_143":144,"_125":285,"_146":286,"_148":287,"_127":198},32,"Start with a subset of patients or services, then refine language and rules before wider rollout.",[288],{"_143":146,"_152":286},31,"Pilot and refine",30,"Link automation into your existing practice-management software where possible and configure message templates.",[294],{"_143":146,"_152":292},29,"Connect and configure",28,"Agree how often different patient groups should be contacted and through which channels.",[300],{"_143":146,"_152":298},27,"Define recall rules",26,"Review your current recall process, systems and policies.",[306],{"_143":146,"_152":304},25,"Quick automation audit",24,"Align recall rules with your policies, then pilot before scaling.",[312],{"_143":146,"_152":310},23,"A clear, compliant rollout","section.section.bg-circuit.animate",[180,361,182,223,224],{"_176":177,"_146":360},[319,320,321,322,323],{"_143":132,"_125":359,"_176":177,"_146":360,"_127":179},{"_143":144,"_125":355,"_146":356,"_148":357,"_127":173},{"_143":132,"_125":351,"_176":352,"_146":353,"_127":354},{"_143":144,"_125":347,"_146":348,"_148":349,"_127":198},{"_143":324,"_125":325,"_326":327,"_328":329,"_127":330},"list",22,"ordered",false,"items",[331,332,333,334],"ul",{"_146":344,"_148":345},{"_146":341,"_148":342},{"_146":338,"_148":339},{"_146":335,"_148":336},"Reception gains clearer visibility on overdue patients.",[337],{"_143":146,"_152":335},"Hygienists run fuller, better-planned books.",[340],{"_143":146,"_152":338},"More patients kept on regular recall cycles.",[343],{"_143":146,"_152":341},"Fewer empty chair slots from DNAs and late cancellations.",[346],{"_143":146,"_152":344},21,"Measured reminders and rebooking flows reduce DNAs without overloading reception.",[350],{"_143":146,"_152":348},20,3,"Keep chairs consistently full","h3",19,"Reduce empty chair time and keep more patients on preventive recall with clear communication.",[358],{"_143":146,"_152":356},18,"Fuller books, smoother recall","bg-circuit",[180,222,182,223,224],{"_176":177,"_146":372},[365,366],{"_143":132,"_125":371,"_176":177,"_146":372,"_127":179},{"_143":144,"_125":367,"_146":368,"_148":369,"_127":173},17,"Small gains in recall and attendance add up quickly across a multi-chair practice.",[370],{"_143":146,"_152":368},16,"Consistent recall keeps chairs fuller",[180,361,182,223,224],{"_176":177,"_146":410},[376,377,378,379,380],{"_143":132,"_125":409,"_176":177,"_146":410,"_127":411},{"_143":144,"_125":405,"_146":406,"_148":407,"_127":173},{"_143":132,"_125":403,"_176":352,"_146":404,"_127":354},{"_143":144,"_125":399,"_146":400,"_148":401,"_127":198},{"_143":324,"_125":381,"_326":327,"_328":382,"_127":330},15,[383,384,385,386],{"_146":396,"_148":397},{"_146":393,"_148":394},{"_146":390,"_148":391},{"_146":387,"_148":388},"Reporting on recall engagement, DNAs, and hygiene uptake.",[389],{"_143":146,"_152":387},"Priority nudges for overdue or high-risk patients.",[392],{"_143":146,"_152":390},"Confirm-or-reschedule reminders without heavy phone work.",[395],{"_143":146,"_152":393},"Automated recall prompts by due date and contact preference.",[398],{"_143":146,"_152":396},14,"This bundle keeps due patients moving, reminds them on time, and helps reception fill gaps with the right people.",[402],{"_143":146,"_152":400},13,"Structured recall, less chasing",12,"A structured recall and hygiene bundle that keeps track of who is due and helps fill gaps with the right patients at the right time.",[408],{"_143":146,"_152":406},11,"The ‘Recall & Hygiene Booster’","h2#recall-hygiene-booster",1,[180,222,182,223,224],{"_176":177,"_146":447},[416,417,418,419,420],{"_143":132,"_125":225,"_176":177,"_146":447,"_127":179},{"_143":144,"_125":443,"_146":444,"_148":445,"_127":173},{"_143":132,"_125":183,"_176":352,"_146":442,"_127":354},{"_143":144,"_125":126,"_146":439,"_148":440,"_127":198},{"_143":324,"_125":421,"_326":327,"_328":422,"_127":330},10,[423,424,425,426],{"_146":436,"_148":437},{"_146":433,"_148":434},{"_146":430,"_148":431},{"_146":427,"_148":428},"Teams cannot see who is overdue and worth prioritising.",[429],{"_143":146,"_152":427},"DNAs and cancellations leave chair time unsold.",[432],{"_143":146,"_152":430},"Reception spends hours filling hygiene gaps by hand.",[435],{"_143":146,"_152":433},"Recall lists live in spreadsheets or outdated systems.",[438],{"_143":146,"_152":436},"Loose recall and inconsistent reminders leave hygiene capacity empty and overdue patients untouched.",[441],{"_143":146,"_152":439},"Where chair time leaks.",7,"When recall is manual and inconsistent, overdue patients drift away and hygiene slots are harder to fill.",[446],{"_143":146,"_152":444},"DNAs and recall gaps quietly empty chairs.",0,"section.hero.title-band",[478,479],{"_176":412,"_146":34},[453,454,455,456,457,458],{"_143":144,"_125":448,"_146":86,"_148":476,"_127":474},{"_143":144,"_125":412,"_146":84,"_148":473,"_127":474},{"_143":144,"_125":177,"_146":470,"_148":471,"_127":198},{"_143":144,"_125":352,"_146":466,"_148":467,"_127":468},{"_143":144,"_125":244,"_146":463,"_148":464,"_127":150},{"_143":144,"_125":271,"_146":459,"_148":460,"_127":461},"See the ‘Recall & Hygiene Booster’",[462],"a.btn.btn-secondary",{"_143":146,"_152":459},"Book a free dental automation audit",[465],{"_143":146,"_152":463},"Typical fit: practices protecting recall, hygiene capacity, follow-up, and front-desk workload.",[469],"p.hero-context",{"_143":146,"_152":466},"Automation that strengthens recall, reduces DNAs, and keeps hygiene lists healthier without more reception pressure.",[472],{"_143":146,"_152":470},[475],"a.hero-breadcrumb__link",{"_143":146,"_152":84},[477],{"_143":146,"_152":86},"hero","title-band",{"_125":448,"_176":412,"_146":34},{"_125":412,"_176":177,"_146":447},{"_125":177,"_176":352,"_146":442},{"_125":352,"_176":177,"_146":410},{"_125":244,"_176":352,"_146":404},{"_125":271,"_176":177,"_146":372},{"_125":225,"_176":177,"_146":360},{"_125":443,"_176":352,"_146":353},{"_125":183,"_176":177,"_146":314},{"_125":126,"_176":244,"_146":308},{"_125":421,"_176":244,"_146":302},{"_125":409,"_176":244,"_146":296},{"_125":405,"_176":244,"_146":290},{"_125":403,"_176":177,"_146":270},{"_125":399,"_176":244,"_146":264},{"_125":381,"_176":244,"_146":258},{"_125":371,"_176":244,"_146":252},{"_125":367,"_176":244,"_146":245},{"_125":359,"_176":177,"_146":221},{"_125":355,"_176":177,"_146":178},{"_125":448,"_502":535,"_504":536,"_506":537},{"_125":412,"_502":503,"_504":505,"_506":507},"types",[511,520,524],"rawJson","{\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"FAQPage\",\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Will this work with our existing dental software?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"In most cases we connect to, or work alongside, your current practice-management system. The goal is to make better use of the data you already hold rather than introduce yet another platform.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How do you handle patient consent and preferences?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"We use the consent status and preferences recorded in your system as the starting point. Patients who opt out of certain channels are respected, and you can choose which groups receive which messages.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Can we separate NHS and private patients?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. We can create different recall rules and messaging for different patient groups, so you can respect contractual and clinical differences while still benefiting from automation.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What about clinical responsibility for recall?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Clinical decisions remain with your dental team. Automation helps deliver agreed recall schedules but does not decide who needs what care. We work with clinical leads to ensure messaging supports, rather than replaces, clinical judgement.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Will patients feel bombarded?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"The system is designed to be measured and respectful. We agree sensible limits on how often patients can be contacted and ensure messages add value rather than noise.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Can we start small?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. Many practices begin with hygiene recall or a specific patient group, prove the benefit and then expand gradually to wider recall.\"\n        }\n      }\n    ]\n  }","parsed",{"_508":509,"_510":511,"_512":513},"@context","https://schema.org","@type","FAQPage","mainEntity",[514,515,516,517,518,519],{"_510":520,"_82":533,"_522":534},{"_510":520,"_82":531,"_522":532},{"_510":520,"_82":529,"_522":530},{"_510":520,"_82":527,"_522":528},{"_510":520,"_82":525,"_522":526},{"_510":520,"_82":521,"_522":523},"Question","Can we start small?","acceptedAnswer",{"_510":524,"_146":196},"Answer","Will patients feel bombarded?",{"_510":524,"_146":201},"What about clinical responsibility for recall?",{"_510":524,"_146":205},"Can we separate NHS and private patients?",{"_510":524,"_146":209},"How do you handle patient consent and preferences?",{"_510":524,"_146":213},"Will this work with our existing dental software?",{"_510":524,"_146":217},[585,77,580,577,574,78,550],"{\n      \"@context\": \"https://schema.org\",\n      \"@graph\": [\n        {\n          \"@type\": \"WebPage\",\n          \"@id\": \"https://silverstone-ai.com/services/dentists#webpage\",\n          \"url\": \"https://silverstone-ai.com/services/dentists\",\n          \"name\": \"Dental Automation for UK Practices - Silverstone AI\",\n          \"description\": \"Silverstone AI automation for dental practices: improve recall uptake, reduce DNAs, and keep treatment books full with timely follow-up.\",\n          \"isPartOf\": {\n            \"@id\": \"https://silverstone-ai.com/services#webpage\"\n          },\n          \"about\": {\n            \"@id\": \"https://silverstone-ai.com/#organization\"\n          },\n          \"breadcrumb\": {\n            \"@id\": \"https://silverstone-ai.com/services/dentists#breadcrumb\"\n          },\n          \"mainEntity\": {\n            \"@id\": \"https://silverstone-ai.com/services/dentists#service\"\n          }\n        },\n        {\n          \"@type\": \"Service\",\n          \"@id\": \"https://silverstone-ai.com/services/dentists#service\",\n          \"name\": \"Dental Automation for UK Practices - Silverstone AI\",\n          \"serviceType\": \"Dental Automation for UK Practices\",\n          \"provider\": {\n            \"@id\": \"https://silverstone-ai.com/#organization\"\n          },\n          \"areaServed\": \"GB\",\n          \"url\": \"https://silverstone-ai.com/services/dentists\",\n          \"mainEntityOfPage\": {\n            \"@id\": \"https://silverstone-ai.com/services/dentists#webpage\"\n          },\n          \"image\": \"https://silverstone-ai.com/a