[{"_1":2},"../routes/blog/article",{"_3":4},"data",{"_5":6,"_7":8},"content",{"_9":44,"_91":10,"_92":14,"_93":20,"_94":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111},"route",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":26,"_54":55,"_56":57,"_58":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":71},"id","route-blog-ai-automations-physio-chiro-clinics-uk","legacyRouteKey","canonical:/blog/ai-automations-physio-chiro-clinics-uk","path","/blog/ai-automations-physio-chiro-clinics-uk","canonical","https://silverstone-ai.com/blog/ai-automations-physio-chiro-clinics-uk","routeGroup","blog","template","article","lifecycle","retained","legacyDisposition","retain","implementationDisposition","refactor","contentDisposition","title","AI Automations for Physio Clinics | Silverstone AI","description","Practical AI automations for small physio and chiro clinics to cut missed sessions, improve treatment completion and save admin time with a 30–60 day rollout.","h1","How small physio & chiro clinics can cut missed sessions and improve treatment completion with simple AI automations","headingPlan",{"_32":33,"_87":88,"_89":90},"productionIndexable",true,"sitemap","breadcrumbs",[79,80,81],"schemaTypes",[77,78],"contentId","content-blog-ai-automations-physio-chiro-clinics-uk","sourceFile","blog/ai-automations-physio-chiro-clinics-uk.html","sourcePath","/blog/ai-automations-physio-chiro-clinics-uk.html","migrationOwner","Codex route migration","contentOwner","Silverstone editorial review","contentStatus","claimsStatus","review-pending","primaryIntent","informational","ctaIntent","related guidance and consultation","parentRouteId","route-blog","relatedRouteIds",[61],"migrationEvidence","repository evidence + live HTTP + live browser","acceptanceIds",[73,74,75,76],"unreso