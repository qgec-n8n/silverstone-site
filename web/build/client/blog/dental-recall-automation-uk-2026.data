nhs.uk/statistical-collections/nhs-dental-statistics",18,"Information Commissioner's Office – What is direct marketing? (PECR guidance)","https://ico.org.uk/for-organisations/direct-marketing-and-privacy-and-electronic-communications/guide-to-pecr/what-is-direct-marketing/",17,"Care Quality Commission – Guidance for dental providers","https://www.cqc.org.uk/guidance-providers/dentistry",16,"NICE – Dental checks: intervals between oral health reviews (CG19)","https://www.nice.org.uk/guidance/cg19",15,"NHS England – Dental recall: Recall interval between routine dental examinations","https://www.england.nhs.uk/long-read/dental-recall-recall-interval-between-routine-dental-examinations/",14,"dental automation page","/services/dentists",13,"how UK SMEs can fix AI automation failures in 2026","../blog/ai-automation-failures-uk-smes-2026","/blog/ai-automation-failures-uk-smes-2026",12,"Enterprise Times",11,"Federation of Small Businesses",10,"AI receptionists for UK SMEs: costs and ROI in 2026","../blog/ai-receptionist-uk-costs-roi-2026","/blog/ai-receptionist-uk-costs-roi-2026",9,"NICE guidance on oral health reviews",8,"NHS England",7,"AI automation and UK GDPR guide",6,"Care Quality Commission guidance for dental providers",5,"Information Commissioner's Office guidance on PECR",4,"AI appointment reminders for UK small businesses",3,"dental practices",2,"practical service layer","/services",1,"British Dental Association",0,"NHS Business Services Authority",{"_164":237,"_243":620,"_245":-5,"_246":621,"_248":622,"_250":623},{"_164":235,"_243":593,"_245":-5,"_246":594,"_248":595,"_250":596},{"_164":232,"_243":288,"_245":-5,"_246":289,"_248":290,"_250":291},{"_164":230,"_243":244,"_245":-5,"_246":247,"_248":249,"_250":251},"sourceSelector","section.section.brand-gradient.animate","sourceId","sourceClasses",[285,286,287],"heading",{"_282":232,"_166":283},"blocks",[252,253,254,255,256],{"_257":248,"_164":281,"_282":232,"_166":283,"_243":284},{"_257":258,"_164":275,"_166":276,"_261":277,"_243":278},{"_257":258,"_164":271,"_166":272,"_261":273,"_243":269},{"_257":258,"_164":266,"_166":267,"_261":268,"_243":269},{"_257":258,"_164":259,"_166":260,"_261":262,"_243":263},"type","paragraph",43,"Book a Free 30-Minute Dental Automation Audit","segments",[264],"a.btn.btn-primary",{"_257":166,"_265":260},"value",42,"Browse the Silverstone AI services overview",[270],"a",{"_257":166,"_265":267},41,"Explore the dental automation page",[274],{"_257":166,"_265":272},40,"See how practical automation can support overdue recalls, hygiene reminders, confirmations, and DNA follow-up without adding more pressure to reception.",[279],"p.section-subtitle",{"_257":166,"_265":280}," See how practical automation can support overdue recalls, hygiene reminders, confirmations, and DNA follow-up without adding more pressure to reception. ",39,"level","Ready to Improve Recall and Reduce DNAs?","h2.section-title","section","brand-gradient","animate","section.section.bg-circuit.animate",[285,590,287,591,592],{"_282":232,"_166":589},[292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325],{"_257":248,"_164":226,"_282":232,"_166":589,"_243":366},{"_257":258,"_164":224,"_166":585,"_261":586,"_243":370},{"_257":258,"_164":222,"_166":578,"_261":579,"_243":370},{"_257":258,"_164":220,"_166":571,"_261":572,"_243":370},{"_257":248,"_164":218,"_282":232,"_166":570,"_243":366},{"_257":258,"_164":214,"_166":566,"_261":567,"_243":370},{"_257":258,"_164":212,"_166":563,"_261":564,"_243":370},{"_257":326,"_164":210,"_328":173,"_329":542,"_243":395},{"_257":258,"_164":206,"_166":529,"_261":530,"_243":370},{"_257":248,"_164":203,"_282":232,"_166":528,"_243":366},{"_257":258,"_164":200,"_166":524,"_261":525,"_243":370},{"_257":258,"_164":197,"_166":517,"_261":518,"_243":370},{"_257":258,"_164":194,"_166":514,"_261":515,"_243":370},{"_257":326,"_164":191,"_328":173,"_329":497,"_243":395},{"_257":258,"_164":188,"_166":488,"_261":489,"_243":370},{"_257":248,"_164":185,"_282":232,"_166":487,"_243":366},{"_257":258,"_164":182,"_166":477,"_261":478,"_243":370},{"_257":258,"_164":179,"_166":473,"_261":474,"_243":370},{"_257":258,"_164":175,"_166":466,"_261":467,"_243":370},{"_257":248,"_164":165,"_282":232,"_166":465,"_243":366},{"_257":258,"_164":460,"_166":461,"_261":462,"_243":370},{"_257":326,"_164":442,"_328":37,"_329":443,"_243":331},{"_257":258,"_164":431,"_166":432,"_261":433,"_243":370},{"_257":258,"_164":423,"_166":424,"_261":425,"_243":370},{"_257":248,"_164":421,"_282":232,"_166":422,"_243":366},{"_257":258,"_164":416,"_166":417,"_261":418,"_243":370},{"_257":326,"_164":393,"_328":173,"_329":394,"_243":395},{"_257":258,"_164":388,"_166":389,"_261":390,"_243":370},{"_257":248,"_164":386,"_282":232,"_166":387,"_243":366},{"_257":258,"_164":381,"_166":382,"_261":383,"_243":370},{"_257":258,"_164":376,"_166":377,"_261":378,"_243":370},{"_257":258,"_164":367,"_166":368,"_261":369,"_243":370},{"_257":248,"_164":364,"_282":232,"_166":365,"_243":366},{"_257":326,"_164":327,"_328":37,"_329":330,"_243":331},"list",38,"ordered","items",[332,333,334,335,336,337,338,339,340,341],"ol",{"_166":201,"_261":362},{"_166":198,"_261":360},{"_166":195,"_261":358},{"_166":192,"_261":356},{"_166":189,"_261":354},{"_166":186,"_261":352},{"_166":183,"_261":350},{"_166":180,"_261":348},{"_166":176,"_261":346},{"_166":167,"_261":342},[343],{"_257":344,"_166":167,"_345":171,"_168":169,"_172":173,"_174":37},"link","href",[347],{"_257":344,"_166":176,"_345":178,"_168":177,"_172":173,"_174":37},[349],{"_257":344,"_166":180,"_345":181,"_168":181,"_172":37,"_174":37},[351],{"_257":344,"_166":183,"_345":184,"_168":184,"_172":37,"_174":37},[353],{"_257":344,"_166":186,"_345":187,"_168":187,"_172":37,"_174":37},[355],{"_257":344,"_166":189,"_345":190,"_168":190,"_172":37,"_174":37},[357],{"_257":344,"_166":192,"_345":193,"_168":193,"_172":37,"_174":37},[359],{"_257":344,"_166":195,"_345":196,"_168":196,"_172":37,"_174":37},[361],{"_257":344,"_166":198,"_345":199,"_168":199,"_172":37,"_174":37},[363],{"_257":344,"_166":201,"_345":202,"_168":202,"_172":37,"_174":37},37,"References","h2",36,"To explore the full range of AI automation Silverstone AI builds specifically for UK dental practices — from recall and appointment reminders to patient intake and follow-up — visit the dental automation page.",[371,372,373],"p",{"_257":166,"_265":375},{"_257":344,"_166":204,"_345":205,"_168":205,"_172":173,"_174":37},{"_257":166,"_265":374},". "," To explore the full range of AI automation Silverstone AI builds specifically for UK dental practices — from recall and appointment reminders to patient intake and follow-up — visit the ",35,"That is why dental recall automation is such a practical 2026 project. It sits close to revenue, supports patient continuity, reduces repetitive admin, and can be introduced in stages without forcing a full operational reset. For owner-led practices, that combination is usually far more valuable than a broader, more ambitious AI rollout that is harder to control.",[379],{"_257":166,"_265":380}," That is why dental recall automation is such a practical 2026 project. It sits close to revenue, supports patient continuity, reduces repetitive admin, and can be introduced in stages without forcing a full operational reset. For owner-led practices, that combination is usually far more valuable than a broader, more ambitious AI rollout that is harder to control. ",34,"Most practices do not need a more elaborate stack. They need a more dependable process for the moments that already matter: when a patient becomes due, when a hygiene appointment needs confirming, and when a missed booking needs a quick reactivation attempt before the opportunity disappears.",[384],{"_257":166,"_265":385}," Most practices do not need a more elaborate stack. They need a more dependable process for the moments that already matter: when a patient becomes due, when a hygiene appointment needs confirming, and when a missed booking needs a quick reactivation attempt before the opportunity disappears. ",33,"A more reliable front desk, not a more complicated one",32,"Even modest improvements can matter. Recovering a handful of hygiene appointments each week and reducing DNAs by a small percentage can add up to meaningful annual revenue, especially when the cost of the system is lower than the value of the appointments it helps protect. The bigger point is reliability: a good dental patient recall system should make the practice easier to run, not just more automated.",[391],{"_257":166,"_265":392}," Even modest improvements can matter. Recovering a handful of hygiene appointments each week and reducing DNAs by a small percentage can add up to meaningful annual revenue, especially when the cost of the system is lower than the value of the appointments it helps protect. The bigger point is reliability: a good dental patient recall system should make the practice easier to run, not just more automated. ",31,[396,397,398,399,400],"ul",{"_166":413,"_261":414},{"_166":410,"_261":411},{"_166":407,"_261":408},{"_166":404,"_261":405},{"_166":401,"_261":402},"Reception time saved: how many hours are no longer being spent on manual chasing and reminder admin?",[403],{"_257":166,"_265":401},"DNA rate: has the percentage of missed appointments fallen after reminders and reactivation were introduced?",[406],{"_257":166,"_265":404},"Confirmation rate: how many booked patients actively confirm through the reminder sequence?",[409],{"_257":166,"_265":407},"Hygiene chair fill rate: are more available hygiene slots being filled each week?",[412],{"_257":166,"_265":410},"Recall reactivation rate: what percentage of overdue patients book after an automated prompt?",[415],{"_257":166,"_265":413},30,"Automation only becomes commercially useful when the practice can see what changed. Fortunately, recall and hygiene workflows are measurable in a way many other AI projects are not.",[419],{"_257":166,"_265":420}," Automation only becomes commercially useful when the practice can see what changed. Fortunately, recall and hygiene workflows are measurable in a way many other AI projects are not. ",29,"What to measure if you want to know whether it is working",28,"If a practice has already tried automation and found it clunky or unreliable, the issue is often not the idea itself but the workflow design. Our article on how UK SMEs can fix AI automation failures in 2026 is useful for spotting those implementation mistakes early.",[426,427,428],{"_257":166,"_265":430},{"_257":344,"_166":207,"_345":209,"_168":208,"_172":173,"_174":37},{"_257":166,"_265":429}," is useful for spotting those implementation mistakes early. "," If a practice has already tried automation and found it clunky or unreliable, the issue is often not the idea itself but the workflow design. Our article on ",27,"This phased approach fits what wider SME automation research keeps showing. Cost pressure and hiring constraints, reflected in sources such as the Federation of Small Businesses, are pushing smaller firms toward targeted systems that save time without requiring more headcount. Recent reporting on AI adoption and implementation patterns, including coverage by Enterprise Times, points in the same direction: focused workflows tend to be easier to govern and more likely to show a clear return.",[434,435,436,437,438],{"_257":166,"_265":441},{"_257":344,"_166":213,"_345":184,"_168":184,"_172":37,"_174":37},{"_257":166,"_265":440},{"_257":344,"_166":211,"_345":181,"_168":181,"_172":37,"_174":37},{"_257":166,"_265":439},", points in the same direction: focused workflows tend to be easier to govern and more likely to show a clear return. ",", are pushing smaller firms toward targeted systems that save time without requiring more headcount. Recent reporting on AI adoption and implementation patterns, including coverage by "," This phased approach fits what wider SME automation research keeps showing. Cost pressure and hiring constraints, reflected in sources such as the ",26,[444,445,446,447],{"_166":457,"_261":458},{"_166":454,"_261":455},{"_166":451,"_261":452},{"_166":448,"_261":449},"Failed-to-book follow-up: if a patient receives a recall prompt but does not act, trigger a second nudge with a direct booking route.",[450],{"_257":166,"_265":448},"DNA reactivation: send a rebooking message shortly after a missed appointment while the patient is still likely to respond.",[453],{"_257":166,"_265":451},"Hygiene reminder journeys: add a 72-hour reminder and a 24-hour reminder with a simple confirmation prompt to reduce avoidable DNAs.",[456],{"_257":166,"_265":454},"Overdue recall cleanup: start with patients whose recall date has passed and who have not rebooked. A short sequence over ten days can recover a meaningful share of lapsed patients.",[459],{"_257":166,"_265":457},25,"The strongest rollout is usually phased. Trying to automate every patient touchpoint at once creates complexity and makes it harder to see what is actually improving. A narrower start gives the practice a cleaner baseline and a faster feedback loop.",[463],{"_257":166,"_265":464}," The strongest rollout is usually phased. Trying to automate every patient touchpoint at once creates complexity and makes it harder to see what is actually improving. A narrower start gives the practice a cleaner baseline and a faster feedback loop. ","The best first workflows to automate in 2026","This is one reason targeted automation tends to outperform generic tools. The workflow is not just about sending messages; it is about sending them in a way that matches the practice's existing clinical and operational logic. If your team is reviewing broader front-desk automation options, our article on AI receptionists for UK SMEs: costs and ROI in 2026 explains why bounded, measurable workflows usually deliver the strongest early return.",[468,469,470],{"_257":166,"_265":472},{"_257":344,"_166":215,"_345":217,"_168":216,"_172":173,"_174":37},{"_257":166,"_265":471}," explains why bounded, measurable workflows usually deliver the strongest early return. "," This is one reason targeted automation tends to outperform generic tools. The workflow is not just about sending messages; it is about sending them in a way that matches the practice's existing clinical and operational logic. If your team is reviewing broader front-desk automation options, our article on ","That matters operationally as well as clinically. If your system simply sends every patient a six-month reminder, it may not reflect the interval recorded by the clinician, and it can create unnecessary noise for both patients and staff. A better setup pulls the trigger from the practice management system or recall record already in use. The automation then sends the right message at the right time for that patient, rather than applying a one-size-fits-all rule.",[475],{"_257":166,"_265":476}," That matters operationally as well as clinically. If your system simply sends every patient a six-month reminder, it may not reflect the interval recorded by the clinician, and it can create unnecessary noise for both patients and staff. A better setup pulls the trigger from the practice management system or recall record already in use. The automation then sends the right message at the right time for that patient, rather than applying a one-size-fits-all rule. ","One of the easiest mistakes in dental automation is to treat every patient as if they should be recalled on the same schedule. That is not how UK guidance frames recall. NHS England and NICE guidance on oral health reviews both make clear that recall intervals should be risk-based and individualised.",[479,480,481,482,483],{"_257":166,"_265":486},{"_257":344,"_166":221,"_345":202,"_168":202,"_172":37,"_174":37},{"_257":166,"_265":485},{"_257":344,"_166":219,"_345":199,"_168":199,"_172":37,"_174":37},{"_257":166,"_265":484}," both make clear that recall intervals should be risk-based and individualised. "," and "," One of the easiest mistakes in dental automation is to treat every patient as if they should be recalled on the same schedule. That is not how UK guidance frames recall. ","Recall intervals should follow clinical guidance, not a blanket timer","The Care Quality Commission guidance for dental providers also reinforces the expectation that practices have safe, reliable systems. Properly configured automation supports that goal because it reduces the chance that important communication depends entirely on memory or ad hoc manual chasing. For a wider explanation of lawful AI and workflow design, see our AI automation and UK GDPR guide.",[490,491,492,493,494],{"_257":166,"_265":496},{"_257":344,"_166":225,"_345":196,"_168":196,"_172":37,"_174":37},{"_257":166,"_265":495},{"_257":344,"_166":223,"_345":171,"_168":169,"_172":173,"_174":37},{"_257":166,"_265":374}," also reinforces the expectation that practices have safe, reliable systems. Properly configured automation supports that goal because it reduces the chance that important communication depends entirely on memory or ad hoc manual chasing. For a wider explanation of lawful AI and workflow design, see our "," The ",[498,499,500,501],{"_166":511,"_261":512},{"_166":508,"_261":509},{"_166":505,"_261":506},{"_166":502,"_261":503},"Ensure your privacy notice and supplier agreements cover the data processing involved.",[504],{"_257":166,"_265":502},"Make opt-out preferences visible and easy to respect.",[507],{"_257":166,"_265":505},"Keep recall and reminder wording clearly service-related rather than promotional.",[510],{"_257":166,"_265":508},"Use the communication channel the patient has agreed to for service updates.",[513],{"_257":166,"_265":511},"In practice, safer recall automation usually follows a few simple rules:",[516],{"_257":166,"_265":514},"Under UK rules, a recall reminder or appointment confirmation is generally treated as a service communication rather than direct marketing, provided the message is clearly related to care the patient has already agreed to receive. The Information Commissioner's Office guidance on PECR is useful here because it helps practices distinguish between a service message and a promotional one. A reminder that a patient is due for review is different from a sales message about whitening or a limited-time offer.",[519,520,521],{"_257":166,"_265":523},{"_257":344,"_166":227,"_345":193,"_168":193,"_172":37,"_174":37},{"_257":166,"_265":522}," is useful here because it helps practices distinguish between a service message and a promotional one. A reminder that a patient is due for review is different from a sales message about whitening or a limited-time offer. "," Under UK rules, a recall reminder or appointment confirmation is generally treated as a service communication rather than direct marketing, provided the message is clearly related to care the patient has already agreed to receive. The ","Compliance is often the reason practices hesitate, and fairly so. Dental teams handle sensitive health information, operate under regulatory oversight, and need to think carefully about how patient communication is triggered and recorded. The good news is that recall and appointment messaging is usually easier to structure safely than owners expect.",[526],{"_257":166,"_265":527}," Compliance is often the reason practices hesitate, and fairly so. Dental teams handle sensitive health information, operate under regulatory oversight, and need to think carefully about how patient communication is triggered and recorded. The good news is that recall and appointment messaging is usually easier to structure safely than owners expect. ","How to automate recalls without creating compliance headaches","This is why recall is such a strong first workflow for practices exploring automation through a practical service layer or a more industry-specific setup for dental practices. The process is repetitive, the commercial impact is visible, and the boundaries are usually clear. If you want a broader view of how reminder logic works across sectors, our guide to AI appointment reminders for UK small businesses covers the mechanics in more detail.",[531,532,533,534,535,536,537],{"_257":166,"_265":541},{"_257":344,"_166":233,"_345":234,"_168":234,"_172":173,"_174":37},{"_257":166,"_265":540},{"_257":344,"_166":231,"_345":205,"_168":205,"_172":173,"_174":37},{"_257":166,"_265":539},{"_257":344,"_166":229,"_345":178,"_168":177,"_172":173,"_174":37},{"_257":166,"_265":538}," covers the mechanics in more detail. ",". The process is repetitive, the commercial impact is visible, and the boundaries are usually clear. If you want a broader view of how reminder logic works across sectors, our guide to "," or a more industry-specific setup for "," This is why recall is such a strong first workflow for practices exploring automation through a ",[543,544,545,546,547],{"_166":560,"_261":561},{"_166":557,"_261":558},{"_166":554,"_261":555},{"_166":551,"_261":552},{"_166":548,"_261":549},"Passing only the exceptions to reception, rather than forcing staff to create every message manually.",[550],{"_257":166,"_265":548},"Triggering a rebooking message after a DNA so the patient can respond before they drift away.",[553],{"_257":166,"_265":551},"Following up patients who received a recall prompt but did not book within a defined window.",[556],{"_257":166,"_265":554},"Issuing hygiene reminders at set intervals before the appointment and asking for confirmation.",[559],{"_257":166,"_265":557},"Sending overdue recall nudges when a patient passes their review date without booking.",[562],{"_257":166,"_265":560},"In most practices, that includes:",[565],{"_257":166,"_265":563},"In a small practice, automation should be understood very practically. It does not mean removing the human element from patient care, and it does not mean handing clinical decisions to software. It means building a reliable communication layer around repetitive tasks that already follow a pattern.",[568],{"_257":166,"_265":569}," In a small practice, automation should be understood very practically. It does not mean removing the human element from patient care, and it does not mean handing clinical decisions to software. It means building a reliable communication layer around repetitive tasks that already follow a pattern. ","What dental recall automation actually means in a small practice","That matters because recall is not just admin. It is one of the systems that protects long-term patient value. A patient who is overdue for hygiene is not only a missed booking. They may also be drifting out of routine care, becoming less loyal to the practice, and more likely to book elsewhere the next time they search online. The operational pressure described by the British Dental Association sits alongside exactly this kind of retention problem.",[573,574,575],{"_257":166,"_265":577},{"_257":344,"_166":236,"_345":187,"_168":187,"_172":37,"_174":37},{"_257":166,"_265":576}," sits alongside exactly this kind of retention problem. "," That matters because recall is not just admin. It is one of the systems that protects long-term patient value. A patient who is overdue for hygiene is not only a missed booking. They may also be drifting out of routine care, becoming less loyal to the practice, and more likely to book elsewhere the next time they search online. The operational pressure described by the ","Demand for dental care in the UK remains high, and official data from the NHS Business Services Authority continues to show the scale of pressure on dental services. But strong demand does not automatically produce a full hygiene diary. Patients still need to be prompted at the right time, reminded clearly, and re-engaged quickly if they miss an appointment. When those steps depend on whoever happens to have a spare moment at reception, consistency usually breaks down.",[580,581,582],{"_257":166,"_265":584},{"_257":344,"_166":238,"_345":190,"_168":190,"_172":37,"_174":37},{"_257":166,"_265":583}," continues to show the scale of pressure on dental services. But strong demand does not automatically produce a full hygiene diary. Patients still need to be prompted at the right time, reminded clearly, and re-engaged quickly if they miss an appointment. When those steps depend on whoever happens to have a spare moment at reception, consistency usually breaks down. "," Demand for dental care in the UK remains high, and official data from the ","Walk into almost any owner-led dental practice and the same contradiction appears. The team is busy, the phone keeps ringing, and the diary looks active. Yet the hygiene book still has gaps, the overdue recall list keeps growing, and a few did-not-attends each week quietly chip away at revenue. In many cases, this is not a demand problem. It is a follow-up problem.",[587],{"_257":166,"_265":588}," Walk into almost any owner-led dental practice and the same contradiction appears. The team is busy, the phone keeps ringing, and the diary looks active. Yet the hygiene book still has gaps, the overdue recall list keeps growing, and a few did-not-attends each week quietly chip away at revenue. In many cases, this is not a demand problem. It is a follow-up problem. ","Why recall gaps quietly cost dental practices money","bg-circuit","parallax-section","compact-section","section.section.bg-lines.animate",[285,619,287,591,592],{"_282":232,"_166":618},[597,598,599],{"_257":248,"_164":232,"_282":232,"_166":618,"_243":366},{"_257":258,"_164":230,"_166":614,"_261":615,"_243":370},{"_257":326,"_164":228,"_328":173,"_329":600,"_243":601},[602,603,604],"ul.article-keypoints",{"_166":611,"_261":612},{"_166":608,"_261":609},{"_166":605,"_261":606},"Keep clinical judgment with people: automation should support safe communication, not make sensitive or high-stakes decisions on its own.",[607],{"_257":166,"_265":605},"Automate service communication first: overdue recall prompts, appointment reminders, confirmations, and simple rebooking journeys are the strongest early wins.",[610],{"_257":166,"_265":608},"Start with recall and hygiene: these workflows are repetitive, measurable, and closely tied to retained revenue.",[613],{"_257":166,"_265":611},"Dental recall automation UK is not about replacing reception. It is about making sure overdue recalls, hygiene reminders, confirmations, and DNA follow-up happen consistently, even when the front desk is busy. For many practices, that means fuller hygiene diaries, fewer missed appointments, and less time spent chasing patients manually.",[616],{"_257":166,"_265":617}," Dental recall automation UK is not about replacing reception. It is about making sure overdue recalls, hygiene reminders, confirmations, and DNA follow-up happen consistently, even when the front desk is busy. For many practices, that means fuller hygiene diaries, fewer missed appointments, and less time spent chasing patients manually. ","The short version","bg-lines","section.hero.title-band",[118,632],{"_282":235,"_166":33},[624,625],{"_257":629,"_164":237,"_630":116,"_243":631},{"_257":258,"_164":235,"_166":626,"_261":627,"_243":370},"For many owner-led practices, the real bottleneck is not demand. It is the follow-up layer between recall due dates, hygiene bookings, confirmations, and rebooking after a missed appointment.",[628],{"_257":166,"_265":626},"image","assetId","img.hero-fallback-image","title-band",{"_164":237,"_282":235,"_166":33},{"_164":235,"_282":232,"_166":618},{"_164":232,"_282":232,"_166":589},{"_164":230,"_282":232,"_166":570},{"_164":228,"_282":232,"_166":528},{"_164":226,"_282":232,"_166":487},{"_164":224,"_282":232,"_166":465},{"_164":222,"_282":232,"_166":422},{"_164":220,"_282":232,"_166":387},{"_164":218,"_282":232,"_166":365},{"_164":214,"_282":232,"_166":283},{"_164":237,"_646":667,"_648":668,"_650":669},{"_164":235,"_646":647,"_648":649