 Discover",0,"Rightmove",{"_160":215,"_221":646,"_223":-5,"_224":647,"_226":648,"_228":649},{"_160":213,"_221":620,"_223":-5,"_224":621,"_226":622,"_228":623},{"_160":212,"_221":260,"_223":-5,"_224":261,"_226":262,"_228":263},{"_160":211,"_221":222,"_223":-5,"_224":225,"_226":227,"_228":229},"sourceSelector","section.section.brand-gradient.animate","sourceId","sourceClasses",[257,258,259],"heading",{"_254":212,"_162":255},"blocks",[230,231,232,233],{"_234":226,"_160":253,"_254":212,"_162":255,"_221":256},{"_234":235,"_160":248,"_162":249,"_238":250,"_221":251},{"_234":235,"_160":243,"_162":244,"_238":245,"_221":246},{"_234":235,"_160":236,"_162":237,"_238":239,"_221":240},"type","paragraph",46,"Book a consultation to map portal leads, integrate your diary and run a 6-week pilot that reduces no-shows and increases viewing-to-instruction rates.","segments",[241],"a.btn.btn-primary",{"_234":162,"_242":237},"value",45,"Explore Silverstone AI support for Estate Agents",[247],"a",{"_234":162,"_242":244},44,"Low-disruption setup for small branches with measurable KPIs",[252],"p.section-subtitle",{"_234":162,"_242":249},43,"level","Start a confirmed-viewing pilot","h2.section-title","section","brand-gradient","animate","section.section.bg-circuit.animate",[257,617,259,618,619],{"_254":212,"_162":616},[264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301],{"_234":226,"_160":208,"_254":212,"_162":616,"_221":342},{"_234":235,"_160":206,"_162":613,"_238":614,"_221":346},{"_234":226,"_160":204,"_254":212,"_162":612,"_221":342},{"_234":302,"_160":202,"_304":190,"_305":595,"_221":307},{"_234":226,"_160":199,"_254":212,"_162":594,"_221":342},{"_234":235,"_160":197,"_162":591,"_238":592,"_221":346},{"_234":302,"_160":194,"_304":37,"_305":563,"_221":564},{"_234":226,"_160":191,"_254":212,"_162":562,"_221":342},{"_234":235,"_160":187,"_162":559,"_238":560,"_221":346},{"_234":302,"_160":184,"_304":190,"_305":544,"_221":307},{"_234":226,"_160":181,"_254":211,"_162":543,"_221":435},{"_234":302,"_160":178,"_304":190,"_305":523,"_221":307},{"_234":226,"_160":175,"_254":212,"_162":522,"_221":342},{"_234":235,"_160":172,"_162":519,"_238":520,"_221":346},{"_234":226,"_160":169,"_254":211,"_162":518,"_221":435},{"_234":302,"_160":161,"_304":190,"_305":501,"_221":307},{"_234":226,"_160":499,"_254":211,"_162":500,"_221":435},{"_234":302,"_160":480,"_304":190,"_305":481,"_221":307},{"_234":226,"_160":478,"_254":211,"_162":479,"_221":435},{"_234":302,"_160":460,"_304":190,"_305":461,"_221":307},{"_234":226,"_160":458,"_254":212,"_162":459,"_221":342},{"_234":235,"_160":454,"_162":455,"_238":456,"_221":346},{"_234":302,"_160":436,"_304":190,"_305":437,"_221":307},{"_234":226,"_160":433,"_254":211,"_162":434,"_221":435},{"_234":302,"_160":415,"_304":190,"_305":416,"_221":307},{"_234":226,"_160":413,"_254":212,"_162":414,"_221":342},{"_234":302,"_160":399,"_304":190,"_305":400,"_221":307},{"_234":226,"_160":397,"_254":212,"_162":398,"_221":342},{"_234":235,"_160":393,"_162":394,"_238":395,"_221":346},{"_234":226,"_160":391,"_254":212,"_162":392,"_221":342},{"_234":302,"_160":373,"_304":190,"_305":374,"_221":307},{"_234":226,"_160":371,"_254":212,"_162":372,"_221":342},{"_234":235,"_160":358,"_162":359,"_238":360,"_221":346},{"_234":226,"_160":356,"_254":212,"_162":357,"_221":342},{"_234":235,"_160":352,"_162":353,"_238":354,"_221":346},{"_234":235,"_160":343,"_162":344,"_238":345,"_221":346},{"_234":226,"_160":340,"_254":212,"_162":341,"_221":342},{"_234":302,"_160":303,"_304":190,"_305":306,"_221":307},"list",42,"ordered","items",[308,309,310,311,312,313,314,315,316,317],"ul",{"_162":195,"_238":338},{"_162":192,"_238":336},{"_162":188,"_238":334},{"_162":185,"_238":332},{"_162":182,"_238":330},{"_162":179,"_238":328},{"_162":176,"_238":326},{"_162":173,"_238":324},{"_162":170,"_238":322},{"_162":163,"_238":318},[319],{"_234":320,"_162":163,"_321":165,"_164":165,"_167":37,"_168":37},"link","href",[323],{"_234":320,"_162":170,"_321":171,"_164":171,"_167":37,"_168":37},[325],{"_234":320,"_162":173,"_321":174,"_164":174,"_167":37,"_168":37},[327],{"_234":320,"_162":176,"_321":177,"_164":177,"_167":37,"_168":37},[329],{"_234":320,"_162":179,"_321":180,"_164":180,"_167":37,"_168":37},[331],{"_234":320,"_162":182,"_321":183,"_164":183,"_167":37,"_168":37},[333],{"_234":320,"_162":185,"_321":186,"_164":186,"_167":37,"_168":37},[335],{"_234":320,"_162":188,"_321":189,"_164":189,"_167":190,"_168":37},[337],{"_234":320,"_162":192,"_321":193,"_164":193,"_167":190,"_168":37},[339],{"_234":320,"_162":195,"_321":196,"_164":196,"_167":190,"_168":37},41,"References","h2",40,"For a full look at the AI automation workflows Silverstone AI builds specifically for UK estate agents — from viewing confirmations and lead qualification to follow-up sequences — visit the estate agent automation page.",[347,348,349],"p",{"_234":162,"_242":351},{"_234":320,"_162":198,"_321":196,"_164":196,"_167":190,"_168":37},{"_234":162,"_242":350},".","For a full look at the AI automation workflows Silverstone AI builds specifically for UK estate agents — from viewing confirmations and lead qualification to follow-up sequences — visit the ",39,"Confirmed viewings are an operational lever small UK estate agents can pull quickly: capture leads fast, confirm within minutes, run two short reminders and make the diary a single source of truth. Done well, this reduces no-shows, raises diary utilisation and speeds vendor decisions — measurable outcomes that often pay back in weeks. Follow PECR and ICO guidance, keep communications human and run a short pilot before wider roll-out.",[355],{"_234":162,"_242":353},38,"Conclusion",37,"If you'd prefer to outsource integration and message design, specialist automation providers can map leads, plug into portals and set KPIs with you. That’s the model Silverstone uses for estate branches: instant portal responses, confirmed-viewing sequences and follow-up workflows that log into your diary and hand hot leads to negotiators. See our estate-agent service overview: Estate Agents and Silverstone AI Services. To discuss a pilot, book a consultation.",[361,362,363,364,365,366,367],{"_234":162,"_242":370},{"_234":320,"_162":205,"_321":196,"_164":196,"_167":190,"_168":37},{"_234":162,"_242":369},{"_234":320,"_162":203,"_321":193,"_164":193,"_167":190,"_168":37},{"_234":162,"_242":368},{"_234":320,"_162":200,"_321":201,"_164":201,"_167":190,"_168":37},{"_234":162,"_242":350},". To discuss a pilot, "," and ","If you'd prefer to outsource integration and message design, specialist automation providers can map leads, plug into portals and set KPIs with you. That’s the model Silverstone uses for estate branches: instant portal responses, confirmed-viewing sequences and follow-up workflows that log into your diary and hand hot leads to negotiators. See our estate-agent service overview: ",36,"A partner to help if you want it",35,[375,376,377,378],{"_162":388,"_238":389},{"_162":385,"_238":386},{"_162":382,"_238":383},{"_162":379,"_238":380},"It solves real operational problems: reduced wasted travel and warmer opportunities for negotiators to convert.",[381],{"_234":162,"_242":379},"Compliance is manageable if you follow PECR and ICO guidance, keep auditable logs and offer opt-outs.",[384],{"_234":162,"_242":382},"Measurable outcomes: you can see impact in diary utilisation and time-to-instruction within weeks.",[387],{"_234":162,"_242":385},"Quick deployment: the stack is modest and often integrates with your existing diary and SMS provider.",[390],{"_234":162,"_242":388},34,"Why this is a low-risk, high-return project for small agents",33,"Automation should free negotiators for high-value conversations, not replace them. Messages must sound like they come from a local branch: include the negotiator’s name and a direct contact number where appropriate. That personal touch, paired with reliable confirmations, builds buyer and vendor trust that drives instructions.",[396],{"_234":162,"_242":394},32,"Customer experience and voice — keep it human",31,[401,402,403],{"_162":410,"_238":411},{"_162":407,"_238":408},{"_162":404,"_238":405},"Keep message templates short and negotiator-friendly, with a manual override for sensitive customers.",[406],{"_234":162,"_242":404},"Hand off warm leads immediately after viewings — a 24-hour follow-up call or message improves vendor confidence.",[409],{"_234":162,"_242":407},"Make confirmed-viewing flags visible in the diary and in daily huddles so negotiators prioritise confirmed viewers.",[412],{"_234":162,"_242":410},30,"Operational tips to get negotiators on board",29,[417,418,419,420],{"_162":430,"_238":431},{"_162":427,"_238":428},{"_162":424,"_238":425},{"_162":421,"_238":422},"Calculate: use the difference between pilot and baseline to estimate recovered viewings and revenue impact.",[423],{"_234":162,"_242":421},"Compare: after 6 weeks, compare the pilot branch to baseline and to a control branch without automation.",[426],{"_234":162,"_242":424},"Pilot: enable the 4-step workflow for a single branch or a capped volume of leads.",[429],{"_234":162,"_242":427},"Baseline: measure current no-show rate and viewing-to-instruction ratio for the last 6 weeks.",[432],{"_234":162,"_242":430},28,"How to run a 6-week pilot","h3",27,[438,439,440,441],{"_162":451,"_238":452},{"_162":448,"_238":449},{"_162":445,"_238":446},{"_162":442,"_238":443},"Time-to-instruction (days from first enquiry to instruction).",[444],{"_234":162,"_242":442},"Viewing-to-offer or viewing-to-instruction ratio.",[447],{"_234":162,"_242":445},"No-show rate (unconfirmed + no-shows as a proportion of total viewings).",[450],{"_234":162,"_242":448},"Confirmed-viewing rate (% of tentative slots confirmed via automation).",[453],{"_234":162,"_242":451},26,"Track these KPIs weekly:",[457],{"_234":162,"_242":455},25,"Measuring impact and the quick ROI test",24,[462,463,464,465],{"_162":475,"_238":476},{"_162":472,"_238":473},{"_162":469,"_238":470},{"_162":466,"_238":467},"Pilot for one branch or postcode area for 6 weeks and agree KPIs before you start.",[468],{"_234":162,"_242":466},"Map diary fields to the automation: time, property, lead source and negotiator.",[471],{"_234":162,"_242":469},"Choose an SMS vendor that supports short links and reply keywords.",[474],{"_234":162,"_242":472},"Identify your three most common lead sources (e.g., Rightmove, Zoopla, website).",[477],{"_234":162,"_242":475},23,"Implementation checklist (fast wins)",22,[482,483,484],{"_162":496,"_238":497},{"_162":493,"_238":494},{"_162":485,"_238":486},"Phone intake — your receptionist or AI-receptionist can create the tentative slot and trigger the confirmation. Silverstone’s estate-agent automation combines instant portal response and diary logging for this purpose: Estate Agents and Services.",[487,488,489,490,491],{"_234":162,"_242":492},{"_234":320,"_162":205,"_321":196,"_164":196,"_167":190,"_168":37},{"_234":162,"_242":369},{"_234":320,"_162":207,"_321":193,"_164":193,"_167":190,"_168":37},{"_234":162,"_242":350},"Phone intake — your receptionist or AI-receptionist can create the tentative slot and trigger the confirmation. Silverstone’s estate-agent automation combines instant portal response and diary logging for this purpose: ","Website contact forms or social DM captures.",[495],{"_234":162,"_242":493},"Portal enquiry webhooks (Rightmove/Zoopla) — trigger immediate confirmation when the lead hits your inbox.",[498],{"_234":162,"_242":496},21,"Where to trigger confirmations",[502,503,504,505],{"_162":515,"_238":516},{"_162":512,"_238":513},{"_162":509,"_238":510},{"_162":506,"_238":507},"CRM or diary where confirmation status is logged and assigned to a negotiator.",[508],{"_234":162,"_242":506},"A simple automation engine (webhook-capable) to receive portal leads and trigger confirmations and reminders.",[511],{"_234":162,"_242":509},"Calendar integration (Google Workspace or Office 365) with shared branch diary access.",[514],{"_234":162,"_242":512},"SMS / voice provider with templates and delivery reporting.",[517],{"_234":162,"_242":515},"Core components","You don't need an enterprise platform to start. Aim for a small-branch setup that integrates with tools you already use.",[521],{"_234":162,"_242":519},"Minimal tech stack and implementation checklist",[524,525,526,527],{"_162":540,"_238":541},{"_162":537,"_238":538},{"_162":534,"_238":535},{"_162":528,"_238":529},"Consult sector guidance from Propertymark and your firm’s GDPR officer: Propertymark.",[530,531,532],{"_234":162,"_242":533},{"_234":320,"_162":210,"_321":180,"_164":180,"_167":37,"_168":37},{"_234":162,"_242":350},"Consult sector guidance from Propertymark and your firm’s GDPR officer: ","Train staff to intervene manually for sensitive cases (vulnerable customers or complex lettings).",[536],{"_234":162,"_242":534},"Provide clear opt-out language in every message and respect preferences instantly.",[539],{"_234":162,"_242":537},"Keep an audit log of every automated message (what was sent, to whom and when).",[542],{"_234":162,"_242":540},"Practical steps for compliance",[545,546],{"_162":553,"_238":554},{"_162":547,"_238":548},"Data protection and (limited) automation: Automated communications can involve profiling and decision-making. Follow ICO guidance on automated decision-making and keep an audit trail with human oversight for any material decisions: https://ico.org.uk/for-organisations/guide-to-data-protection/automated-decision-making-and-profiling/.",[549,550,551],{"_234":162,"_242":552},{"_234":320,"_162":186,"_321":186,"_164":186,"_167":37,"_168":37},{"_234":162,"_242":350},"Data protection and (limited) automation: Automated communications can involve profiling and decision-making. Follow ICO guidance on automated decision-making and keep an audit trail with human oversight for any material decisions: ","PECR and messaging consent: The Privacy and Electronic Communications Regulations govern SMS and automated calls. Ensure your reminders comply with PECR: include opt-out options and keep records of consent where required. See the ICO’s PECR guidance: https://ico.org.uk/for-organisations/guide-to-pecr/.",[555,556,557],{"_234":162,"_242":558},{"_234":320,"_162":183,"_321":183,"_164":183,"_167":37,"_168":37},{"_234":162,"_242":350},"PECR and messaging consent: The Privacy and Electronic Communications Regulations govern SMS and automated calls. Ensure your reminders comply with PECR: include opt-out options and keep records of consent where required. See the ICO’s PECR guidance: ","Automated confirmations and reminders involve personal data and electronic communications; two regulatory points are essential:",[561],{"_234":162,"_242":559},"Compliance and customer expectations — what you must check first",[565,566,567,568],"ol",{"_162":587,"_238":588},{"_162":577,"_238":578},{"_162":573,"_238":574},{"_162":569,"_238":570},"Step 4 — Diary logging & negotiator hand-off Record the prospect’s response automatically: confirmed, rescheduled, cancelled or no response. Make this visible in the branch diary and to the assigned negotiator. Prioritise confirmed viewers in daily huddles and assign follow-up tasks for \"hot\" prospects immediately after a viewing — a short call or message within 24 hours helps convert instructions.",[571],{"_234":162,"_242":572}," Step 4 — Diary logging & negotiator hand-off  Record the prospect’s response automatically: confirmed, rescheduled, cancelled or no response. Make this visible in the branch diary and to the assigned negotiator. Prioritise confirmed viewers in daily huddles and assign follow-up tasks for \"hot\" prospects immediately after a viewing — a short call or message within 24 hours helps convert instructions.  ","Step 3 — Reminder sequence Send two short reminders: one at 24 hours and one at 2 hours before the appointment. Each message should be single-action: confirm, reschedule or cancel. Use a one-tap reschedule link or a reply keyword to make it effortless to change plans — this convenience reduces last-minute \"no response\" slots. Keep messages brief and useful: approximate travel time, parking notes and any documents to bring.",[575],{"_234":162,"_242":576}," Step 3 — Reminder sequence  Send two short reminders: one at 24 hours and one at 2 hours before the appointment. Each message should be single-action: confirm, reschedule or cancel. Use a one-tap reschedule link or a reply keyword to make it effortless to change plans — this convenience reduces last-minute \"no response\" slots. Keep messages brief and useful: approximate travel time, parking notes and any documents to bring.  ","Step 2 — Immediate confirmation (within 2 minutes) Send an instant SMS or automated voice message confirming time, exact address and a three-line checklist: where to meet, how long the viewing will be, and a contact number for delays. Keep the tone human: “Thanks, Sam — we’ve pencilled you in for Thursday 6pm at 14 High Street. Please ring 01234 567890 if you’re running late.” Evidence from portal insight emphasises responsiveness as a differentiator for buyers and tenants (Rightmove, Zoopla Discover).",[579,580,581,582,583],{"_234":162,"_242":586},{"_234":320,"_162":216,"_321":177,"_164":177,"_167":37,"_168":37},{"_234":162,"_242":585},{"_234":320,"_162":214,"_321":174,"_164":174,"_167":37,"_168":37},{"_234":162,"_242":584},").  ",", "," Step 2 — Immediate confirmation (within 2 minutes)  Send an instant SMS or automated voice message confirming time, exact address and a three-line checklist: where to meet, how long the viewing will be, and a contact number for delays. Keep the tone human: “Thanks, Sam — we’ve pencilled you in for Thursday 6pm at 14 High Street. Please ring 01234 567890 if you’re running late.” Evidence from portal insight emphasises responsiveness as a differentiator for buyers and tenants (","Step 1 — Capture Capture essential data immediately: name, phone, email, source (Rightmove/Zoopla/portal), property address and preferred times. Create a tentative diary slot as soon as the lead enters the system to prevent double-booking and to signal the enquiry is being actioned.",[589],{"_234":162,"_242":590}," Step 1 — Capture  Capture essential data immediately: name, phone, email, source (Rightmove/Zoopla/portal), property address and preferred times. Create a tentative diary slot as soon as the lead enters the system to prevent double-booking and to signal the enquiry is being actioned.  ","The workflow below is pragmatic and low-disruption. It works whether leads arrive via portals, social or phone.",[593],{"_234":162,"_242":591},"A practical 4-step viewing confirmation workflow",[596,597,598,599],{"_162":609,"_238":610},{"_162":606,"_238":607},{"_162":603,"_238":604},{"_162":600,"_238":601},"Measurable commercial impacts: Trackable outcomes include fewer no-shows, better viewing-to-offer ratios and faster time-to-instruction — metrics that translate automation into branch value.",[602],{"_234":162,"_242":600},"Vendor confidence and instruction velocity: A branch that reliably confirms and follows up viewings demonstrates professionalism to vendors and increases the chance of instruction.",[605],{"_234":162,"_242":603},"Customer expectations and speed: Buyers expect quick, clear confirmations after an online enquiry; fast, reliable communications are a differentiator in early stages of purchase decisions.",[608],{"_234":162,"_242":606},"Diary utilisation and negotiator productivity: Small teams cannot absorb repeated empty slots. Confirmed viewings maximise billable time and reduce mileage and travel scheduling losses.",[611],{"_234":162,"_242":609},"Why confirmed viewings matter: the business case for small branches","Small branches routinely lose time, staff morale and margin on empty viewings. A single missed viewing can mean wasted travel, lost productive hours and a slower route to instruction from a motivated vendor. The fix is straightforward: confirm viewings quickly, keep prospects warm with short reminders and ensure your diary reflects who’s definitely coming. This sequence is operational, measurable and low-risk — it supports negotiators with warmer, better-prioritised appointments rather than replacing them.",[615],{"_234":162,"_242":613},"Intro — the cost of unconfirmed viewings","bg-circuit","parallax-section","compact-section","section.section.bg-lines.animate",[257,645,259,618,619],{"_254":212,"_162":644},[624,625,626],{"_234":226,"_160":212,"_254":212,"_162":644,"_221":342},{"_234":235,"_160":211,"_162":641,"_238":642,"_221":346},{"_234":302,"_160":209,"_304":190,"_305":627,"_221":628},[629,630,631],"ul.article-keypoints",{"_162":638,"_238":639},{"_162":635,"_238":636},{"_162":632,"_238":633},"Compliance tips for PECR and ICO guidance",[634],{"_234":162,"_242":632},"Low-tech stack and 6-week pilot approach",[637],{"_234":162,"_242":635},"Four-step confirmation and reminder workflow",[640],{"_234":162,"_242":638},"A practical guide for small UK estate agents to implement automated viewing confirmations that reduce no-shows, improve diary use and speed vendor instructions.",[643],{"_234":162,"_242":641},"The short version","bg-lines","section.hero.title-band",[118,658],{"_254":213,"_162":33},[650,651],{"_234":655,"_160":215,"_656":116,"_221":657},{"_234":235,"_160":213,"_162":652,"_238":653,"_221":346},"Step-by-step automation to confirm viewings, reduce no-shows and convert warmer leads for small estate branches.",[654],{"_234":162,"_242":652},"image","assetId","img.hero-fallback-image","title-band",{"_160":215,"_254":213,"_162":33},{"_160":213,"_254":212,"_162":644},{"_160":212,"_254":212,"_162":616},{"_160":211,"_254":212,"_162":612},{"_160":209,"_254":212,"_162":594},{"_160":208,"_254":211,"_162":686},{"_160":206,"_254":211,"_162":685},{"_160":204,"_254":211,"_162":684},{"_160":202,"_254":211,"_162":683},{"_160":199,"_254":212,"_162":562},{"_160":197,"_254":211,"_162":543},{"_160":194,"_254":212,"_162":522},{"_160":191,"_254":211,"_162":518},{"_160":187,"_254":211,"_162":500},{"_160":184,"_254":211,"_162":479},{"_160":181,"_254":212,"_162":459},{"_160":178,"_254":211,"_162":434},{"_160":175,"_254":212,"_162":414},{"_160":172,"_254":212,"_162":398},{"_160":169,"_254":212,"_162":392},{"_160":161,"_254":212,"_162":372},{"_160":499,"_254":212,"_162":357},{"_160":480,"_254":212,"_162":341},{"_160":478,"_254":212,"_162":255},"Step 4 — Diary logging & negotiator hand-off","Step 3 — Reminder sequence","Step 2 — Immediate confirmation (within 2 minutes)","Step 1 — Capture",{"_160":215,"_689":710,"_691":711,"_693":712},{"_160":213,"_689":690,"_691":692,"_693":694},"types",[78,705],"rawJson","{\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"BreadcrumbList\",\n      \"@id\": \"https://silverstone-ai.com/blog/estate-agent-viewing-confirmations-uk#breadcrumb\",\n      \"itemListElement\": [\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 1,\n          \"name\": \"Home\",\n          \"item\": \"https://silverstone-ai.com\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 2,\n          \"name\": \"Blog\",\n          \"item\": \"https://silverstone-ai.com/blog\"\n        },\n        {\n          \"@type\": \"ListItem\",\n          \"position\": 3,\n          \"name\": \"How small UK estate agents can use automated viewing confirmations to cut no-shows and win instructions\",\n          \"item\": \"https://silverstone-ai.com/blog/estate-agent-viewing-confirmations-uk\"\n        }\n      ]\n    }","parsed",{"_695":696,"_697":78,"_698":699,"_700":701},"@context","https://schema.org","@type","@id","https://silverstone-ai.com/blog/estate-agent-viewing-confirmations-uk#breadcrumb","itemListElement",[702,703,704],{"_697":705,"_706":213,"_82":85,"_707":709},{"_697":705,"_706":212,"_82":83,"_707":708},{"_697":705,"_706":2