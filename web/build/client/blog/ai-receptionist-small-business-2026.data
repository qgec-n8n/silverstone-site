_153":154,"_155":154,"_156":157,"_158":37},"order",9,"text","services overview","sourceHref","/services","migratedHref","external",false,"valid",8,"online coaches","/services/fitness-coaches",7,"gyms","/services/gyms-fitness-studios",6,"dental practices","/services/dentists",5,"Physio clinics and chiropractors","/services/physios-chiropractors",4,"eCommerce brands","/services/ecommerce",3,"Trades businesses","/services/trades",2,"Salons and barbers","/services/salons-barbers",1,"Hospitality teams","/services/hospitality",0,"Estate agents","/services/estate-agents",{"_149":183,"_190":545,"_192":-5,"_193":546,"_195":547,"_197":548},{"_149":180,"_190":518,"_192":-5,"_193":519,"_195":520,"_197":521},{"_149":177,"_190":230,"_192":-5,"_193":231,"_195":232,"_197":233},{"_149":174,"_190":191,"_192":-5,"_193":194,"_195":196,"_197":198},"sourceSelector","section.section.brand-gradient.animate","sourceId","sourceClasses",[227,228,229],"heading",{"_224":177,"_151":225},"blocks",[199,200,201,202],{"_203":195,"_149":223,"_224":177,"_151":225,"_190":226},{"_203":204,"_149":217,"_151":218,"_207":219,"_190":220},{"_203":204,"_149":212,"_151":213,"_207":214,"_190":215},{"_203":204,"_149":205,"_151":206,"_207":208,"_190":209},"type","paragraph",41,"Book a Free 30‑Minute Front-Desk AI Audit","segments",[210],"a.btn.btn-primary",{"_203":151,"_211":206},"value",40,"Browse the Silverstone AI services overview",[216],"a",{"_203":151,"_211":213},39,"See how practical automation can capture more enquiries, confirm more bookings, and reduce routine admin across your business.",[221],"p.section-subtitle",{"_203":151,"_211":222}," See how practical automation can capture more enquiries, confirm more bookings, and reduce routine admin across your business. ",38,"level","Ready to Fix the Front Desk First?","h2.section-title","section","brand-gradient","animate","section.section.bg-circuit.animate",[227,515,229,516,517],{"_224":177,"_151":514},[234,235,236,237,238,239,240,241,242,243,244,245,246,2