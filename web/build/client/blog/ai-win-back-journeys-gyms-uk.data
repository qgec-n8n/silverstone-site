,"https://www.leisuredb.com/blog/state-of-the-uk-fitness-industry-report-2025",11,"gyms and fitness studios automation page",10,"Silverstone AI's automation services",9,"Ramp AI Index",8,"AI appointment reminders for UK small businesses","/blog/ai-appointment-reminders-uk-2026",7,"AI Automation and UK GDPR: A 2026 SME Guide",6,"ICO guidance on UK GDPR",5,"Privacy and Electronic Communications Regulations (PECR)",4,"UK government's Help to Grow AI guidance",3,"Silverstone AI's gym and fitness studio service",2,"Twilio's State of Customer Engagement Report",1,"IHRSA research",0,"State of the UK Fitness Industry Report 2025",{"_161":221,"_227":621,"_229":-5,"_230":622,"_232":623,"_234":624},{"_161":219,"_227":595,"_229":-5,"_230":596,"_232":597,"_234":598},{"_161":217,"_227":266,"_229":-5,"_230":267,"_232":268,"_234":269},{"_161":215,"_227":228,"_229":-5,"_230":231,"_232":233,"_234":235},"sourceSelector","section.section.brand-gradient.animate","sourceId","sourceClasses",[263,264,265],"heading",{"_260":217,"_163":261},"blocks",[236,237,238,239],{"_240":232,"_161":259,"_260":217,"_163":261,"_227":262},{"_240":241,"_161":254,"_163":255,"_244":256,"_227":257},{"_240":241,"_161":249,"_163":250,"_244":251,"_227":252},{"_240":241,"_161":242,"_163":243,"_244":245,"_227":246},"type","paragraph",55,"Book a consultation to discuss a practical Membership Reactivation Engine for your gym or fitness studio.","segments",[247],"a.btn.btn-primary",{"_240":163,"_248":243},"value",54,"Explore Silverstone AI support for Gyms & Fitness Studios",[253],"a",{"_240":163,"_248":250},53,"See how Silverstone AI can help your gym or studio identify inactive members, send timely follow-ups, and hand replies to staff.",[258],"p.section-subtitle",{"_240":163,"_248":255},52,"level","Plan your member reactivation workflow","h2.section-title","section","brand-gradient","animate","section.section.bg-circuit.animate",[263,592,265,593,594],{"_260":217,"_163":575},[270,271,272,273,274,275,276,277,278,279,2