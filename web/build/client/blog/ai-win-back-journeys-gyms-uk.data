[{"_1":2},"../routes/blog/article",{"_3":4},"data",{"_5":6,"_7":8},"content",{"_9":44,"_91":10,"_92":14,"_93":20,"_94":95,"_96":97,"_98":99,"_100":101,"_102":103,"_104":105,"_106":107,"_108":109,"_110":111},"route",{"_9":10,"_11":12,"_13":14,"_15":16,"_17":18,"_19":20,"_21":22,"_23":24,"_25":26,"_27":26,"_28":29,"_30":31,"_32":33,"_34":35,"_36":37,"_38":37,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52,"_53":26,"_54":55,"_56":57,"_58":59,"_60":61,"_62":63,"_64":65,"_66":67,"_68":69,"_70":71,"_72":71},"id","route-blog-ai-win-back-journeys-gyms-uk","legacyRouteKey","canonical:/blog/ai-win-back-journeys-gyms-uk","path","/blog/ai-win-back-journeys-gyms-uk","canonical","https://silverstone-ai.com/blog/ai-win-back-journeys-gyms-uk","routeGroup","blog","template","article","lifecycle","retained","legacyDisposition","retain","implementationDisposition","refactor","contentDisposition","title","AI Win-Back Journeys for Gyms | Silverstone AI","description","Learn how UK gyms and fitness studios can use AI win-back journeys to re-engage inactive members, reduce churn, and recover revenue without blanket discounts.","h1","How UK Gyms and Fitness Studios Can Use AI Win-Back Journeys to Reactivate Inactive Members","headingPlan",{"_32":33,"_87":88,"_89":90},"productionIndexable",true,"sitemap","breadcrumbs",[79,80,81],"schemaTypes",[77,78],"contentId","content-blog-ai-win-back-journeys-gyms-uk","sourceFile","blog/ai-win-back-journeys-gyms-uk.html","sourcePath","/blog/ai-win-back-journeys-gyms-uk.html","migrationOwner","Codex route migration","contentOwner","Silverstone editorial review","contentStatus","claimsStatus","review-pending","primaryIntent","informational","ctaIntent","related guidance and consultation","parentRouteId","route-blog","relatedRouteIds",[61],"migrationEvidence","repository evidence + live HTTP + live browser","acceptanceIds",[73,74,75,76],"unresolvedNotes",[],"publishedAt","2026-03-18T07:06:08.690Z","modifiedAt","AC-003","AC-004","AC-006","AC-007","Article","BreadcrumbList",{"_82":85,"_13":86},{"_82":83,"_13":84},{"_82":33,"_13":14},"name","Blog","/blog","Home","/","h1Source","A-01 route inventory","supportingHeadingsStatus","pending content migration","routeId","routePath","kind","source",{"_728":12,"_729":46,"_730":731,"_732":733,"_734":735,"_736":737},"metadata",{"_28":29,"_30":31,"_15":16,"_690":691,"_679":692,"_693":694,"_695":696,"_697":698},"schema",[646,647],"headings",[634,635,636,637,638,639,640,641,642,643,644,645],"sections",[223,224,225,226],"links",[139,140,141,142,143,144,145,146,147,148,149,150,151,152,153,154,155,156,157,158,159,160],"assets",[115],"interactions",[],"flags",{"_53":26,"_54":55,"_112":113,"_68":114},"riskNotes","3 images lack width/height",[],{"_9":116,"_117":118,"_47":119,"_120":121,"_122":123,"_124":125,"_126":127,"_128":129,"_130":131,"_132":133,"_134":133,"_135":136,"_137":26,"_138":-5},"asset-53f555c797711f53","role","hero","assets/images/blog/derived/blog_35-960.jpg","sourceReference","../assets/images/blog/derived/blog_35-960.jpg","sourceSha256","1b59869a9c15d6b27a2739b54b6536601f6da22c7e420240e9b37900dbf0a101","sourceBytes",52065,"publicPath","/migrated-assets/assets/images/blog/derived/blog_35-960.jpg","width",960,"height",640,"sourceAlt","","altCandidate","altStatus","decorative-or-missing-review","inventoryDisposition","fallbackForMissingSource",{"_161":221,"_163":222,"_165":197,"_167":197,"_168":37,"_170":37},{"_161":219,"_163":220,"_165":194,"_167":194,"_168":37,"_170":37},{"_161":217,"_163":218,"_165":191,"_167":191,"_168":37,"_170":37},{"_161":215,"_163":216,"_165":188,"_167":188,"_168":169,"_170":37},{"_161":213,"_163":214,"_165":182,"_167":182,"_168":37,"_170":37},{"_161":211,"_163":212,"_165":179,"_167":179,"_168":37,"_170":37},{"_161":209,"_163":210,"_165":176,"_167":176,"_168":37,"_170":37},{"_161":207,"_163":208,"_165":166,"_167":166,"_168":169,"_170":37},{"_161":204,"_163":205,"_165":206,"_167":206,"_168":169,"_170":37},{"_161":202,"_163":203,"_165":1