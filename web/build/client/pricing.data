:431,"_432":433,"_434":435,"_436":437},"metadata",{"_28":29,"_30":31,"_15":16,"_387":388,"_389":-5,"_390":391,"_392":393,"_394":395},"schema",[233,234],"headings",[229,230,231,232],"sections",[112,113,114,115],"links",[],"assets",[],"interactions",[],"flags",{"_53":26,"_54":55,"_109":110,"_67":111},"riskNotes","2 images lack width/height",[],{"_116":204,"_118":205,"_120":-5,"_121":206,"_123":207,"_125":208},{"_116":191,"_118":192,"_120":-5,"_121":193,"_123":194,"_125":195},{"_116":154,"_118":155,"_120":-5,"_121":156,"_123":157,"_125":158},{"_116":117,"_118":119,"_120":-5,"_121":122,"_123":124,"_125":126},"order",5,"sourceSelector","section.section.brand-gradient.animate","sourceId","sourceClasses",[151,152,153],"heading",{"_147":148,"_133":149},"blocks",[127,128,129],{"_130":123,"_116":146,"_147":148,"_133":149,"_118":150},{"_130":131,"_116":140,"_133":141,"_135":142,"_118":143},{"_130":131,"_116":132,"_133":134,"_135":136,"_118":137},"type","paragraph",14,"text","Book a Free 30-Minute Automation Audit","segments",[138],"a.btn.btn-primary",{"_130":133,"_139":134},"value",13,"In a focused 30-minute audit, we show which pack or module matches your current revenue leak, where a smaller starting scope makes sense, and what to launch first for the fastest payback.",[144],"p.section-subtitle",{"_130":133,"_139":145}," In a focused 30-minute audit, we show which pack or module matches your current revenue leak, where a smaller starting scope makes sense, and what to launch first for the fastest payback. ",12,"level",2,"Price the right first workflow, not the biggest possible project.","h2.section-title","section","brand-gradient","animate",4,"section.section.bg-lines.animate",[151,188,153,189,190],{"_147":148,"_133":187},[159,160,161,162,163,164],{"_130":123,"_116":186,"_147":148,"_133":187,"_118":150},{"_130":131,"_116":182,"_133":183,"_135":184,"_118":168},{"_130":131,"_116":178,"_133":179,"_135":180,"_118":168},{"_130":131,"_116":174,"_133":175,"_135":176,"_118":168},{"_130":131,"_116":170,"_133":171,"_135":172,"_118":168},{"_130":131,"_116":165,"_133":166,"_135":167,"_118":168},11,"Most focused systems go live within one to two weeks after the audit, depending on your stack, approvals, and the number of moving parts.",[169],"p",{"_130":133,"_139":166},10,"We review your current bottlenecks, identify the highest-value workflow to automate first, and recommend the pack or module that fits your stage, team, and tools.",[173],{"_130":133,"_139":171},9,"Yes. Most clients start with one high-leverage workflow, prove the ROI, then add the next module once the first system is paying back.",[177],{"_130":133,"_139":175},8,"Start with a flagship pack if you want the fastest route to a complete workflow. Use the industry atlas if you need a smaller fix first or want to compare multiple options.",[181],{"_130":133,"_139":179},7,"The setup fee covers the build, integrations, testing, and launch. The monthly retainer covers monitoring, support, iteration, and the live automation layer.",[185],{"_130":133,"_139":183},6,"Pricing FAQs for UK small businesses","bg-lines","parallax-section","compact-section",1,"section.section.bg-circuit.animate",[151,203,153,189,190],{"_147":148,"_133":202},[196,197],{"_130":123,"_116":154,"_147":148,"_133":202,"_118":150},{"_130":131,"_116":117,"_133":198,"_135":199,"_118":143},"Use the industry selector for the fastest route to ROI, or the atlas below to compare every starter pack, module, and premium build.",[200],{"_130":133,"_139":201}," Use the industry selector for the fastest route to ROI, or the atlas below to compare every starter pack, module, and premium build. ","Choose the fastest-fit pack, then compare every industry.","bg-circuit",0,"section.hero.title-band",[227,228],{"_147":191,"_133":33},[209,210,211,212],{"_130":131,"_116":204,"_133":223,"_135":224,"_118":225},{"_130":131,"_116":191,"_133":220,"_135":221,"_118":168},{"_130":131,"_116":148,"_133":134,"_135":218,"_118":137},{"_130":131,"_116":213,"_133":214,"_135":215,"_118":216},3,"Jump to the pricing atlas",[217],"a.btn.btn-secondary",{"_130":133,"_139":214},[219],{"_130":133,"_139":134},"Compare starter packs, industry atlases, and monthly retainers before you book an audit.",[222],{"_130":133,"_139":220},"HOME",[226],"a.hero-breadcrumb__link",{"_130":133,"_139":223},"hero","title-band",{"_116":204,"_147":191,"_133":33},{"_116":191,"_147":148,"_133":202},{"_116":148,"_147":148,"_133":187},{"_116":213,"_147":148,"_133":149},{"_116":204,"_235":272,"_237":273,"_239":274},{"_116":191,"_235":236,"_237":238,"_239":240},"types",[244,254,258],"rawJson","{\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"@id\": \"https://silverstone-ai.com/pricing#pricing-faq\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How do the setup fees and monthly retainers work?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"The setup fee covers the build, integrations, testing and launch work. The monthly retainer covers monitoring, iteration, support and the ongoing automation layer once the system is live.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Should I start with a flagship pack or an industry atlas module?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Start with a flagship pack if you want the fastest route to a complete workflow. Use the industry atlas if you need a smaller fix first or want to compare multiple modules and bundles before you commit.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can we start with one workflow and expand later?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes. Many clients begin with one high-leverage workflow, prove the ROI, then add the next module once the first system is paying back.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What happens in the automation audit?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"We look at your current bottlenecks, identify the highest-value workflow to automate first, and recommend the pack or module that fits your stage, team and existing tools.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How quickly can a pricing pack go live?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Most focused systems can launch within one to two weeks after the audit, depending on your stack, approvals and how many moving parts need to be connected.\"\n          }\n        }\n      ]\n    }","parsed",{"_241":242,"_243":244,"_245":246,"_247":248},"@context","https://schema.org","@type","FAQPage","@id","https://silverstone-ai.com/pricing#pricing-faq","mainEntity",[249,250,251,252,253],{"_243":254,"_80":269,"_256":270},{"_243":254,"_80":266,"_256":267},{"_243":254,"_80":263,"_256":264},{"_243":254,"_80":260,"_256":261},{"_243":254,"_80":255,"_256":257},"Question","How quickly can a pricing pack go live?","acceptedAnswer",{"_243":258,"_133":259},"Answer","Most focused systems can launch within one to two weeks after the audit, depending on your stack, approvals and how many moving parts need to be connected.","What happens in the automation audit?",{"_243":258,"_133":262},"We look at your current bottlenecks, identify the highest-value workflow to automate first, and recommend the pack or module that fits your stage, team and existing tools.","Can we start with one workflow and expand later?",{"_243":258,"_133":265},"Yes. Many clients begin with one high-leverage workflow, prove the ROI, then add the next module once the first system is paying back.","Should I start with a flagship pack or an industry atla