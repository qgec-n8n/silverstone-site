AC-006","AC-007","route-services","route-pricing","route-book","route-contact","WebPage","BreadcrumbList",{"_83":85,"_13":86},{"_83":84,"_13":14},"name","How we work","Home","/","h1Source","H-01 approved metadata map","supportingHeadingsStatus","approved editorial overlay","routeId","routePath","kind","core","source",{"_294":12,"_295":46,"_296":297,"_298":299,"_300":301,"_302":303},"metadata",{"_28":29,"_30":31,"_15":16,"_261":262,"_263":-5,"_264":265,"_266":267,"_268":269},"schema",[252],"headings",[235,236,237,238,239,240,241,242,243,244,245],"sections",[127,128,129,130,131],"links",[116],"assets",[],"interactions",[],"flags",{"_53":54,"_55":56,"_113":114,"_68":115},"riskNotes","Assurance wording is draft-safe. Contractual remedies and formal assurance terms remain legal-review items before production publication.",[],{"_117":118,"_119":120,"_121":122,"_123":122,"_124":125,"_126":37},"order",0,"text","book a discovery call","sourceHref","/book","migratedHref","external",false,"valid",{"_117":118,"_133":223,"_135":-5,"_136":224,"_138":225,"_140":226},{"_117":146,"_133":211,"_135":-5,"_136":212,"_138":213,"_140":214},{"_117":160,"_133":182,"_135":-5,"_136":183,"_138":184,"_140":185},{"_117":164,"_133":165,"_135":-5,"_136":166,"_138":167,"_140":168},{"_117":132,"_133":134,"_135":-5,"_136":137,"_138":139,"_140":141},4,"sourceSelector","[data-approved-section=\"4\"]","sourceId","sourceClasses",[163],"heading",{"_159":160,"_119":161},"blocks",[142,143],{"_144":138,"_117":118,"_159":160,"_119":161,"_133":162},{"_144":145,"_117":146,"_119":147,"_148":149,"_133":150},"type","paragraph",1,"If that delivery model fits the way you want to buy, book a discovery call.","segments",[151,152,153],"[data-approved-section=\"4-paragraph-1\"]",{"_144":119,"_154":158},{"_144":156,"_119":120,"_157":122,"_121":122,"_124":125,"_126":37},{"_144":119,"_154":155},"value",".","link","href","If that delivery model fits the way you want to buy, ","level",2,"Next step","[data-approved-section=\"4-heading\"]","approved-content",3,"[data-approved-section=\"3\"]",[163],{"_159":160,"_119":180},[169,170,171],{"_144":138,"_117":118,"_159":160,"_119":180,"_133":181},{"_144":145,"_117":146,"_119":176,"_148":177,"_133":178},{"_144":145,"_117":160,"_119":172,"_148":173,"_133":174},"Commercial outcomes, media spend, third-party platforms and external market conditions are not guaranteed. Full assurance terms remain a draft subject to legal review.",[175],"[data-approved-section=\"3-paragraph-2\"]",{"_144":119,"_154":172},"Public assurance is limited to the parts of delivery Silverstone can reasonably control: written scope, milestone approvals, defined revision rounds, covered defect correction and accountable change control.",[179],"[data-approved-section=\"3-paragraph-1\"]",{"_144":119,"_154":176},"Silverstone Delivery Assurance","[data-approved-section=\"3-heading\"]","[data-approved-section=\"2\"]",[163],{"_159":160,"_119":209},[186,187],{"_144":138,"_117":118,"_159":160,"_119":209,"_133":210},{"_144":188,"_117":146,"_189":37,"_190":191,"_133":192},"list","ordered","items",[193,194,195,196],"[data-approved-section=\"2-list\"]",{"_119":206,"_148":207},{"_119":203,"_148":204},{"_119":200,"_148":201},{"_119":197,"_148":198},"Handover, monitoring and the next decision point",[199],{"_144":119,"_154":197},"Implementation and tested first release",[202],{"_144":119,"_154":200},"Information architecture, workflow or system design",[205],{"_144":119,"_154":203},"Discovery and requirements",[208],{"_144":119,"_154":206},"Milestones and review","[data-approved-section=\"2-heading\"]","[data-approved-section=\"1\"]",[163],{"_159":160,"_119":221},[215,216],{"_144":138,"_117":118,"_159":160,"_119":221,"_133":222},{"_144":145,"_117":146,"_119":217,"_148":218,"_133":219},"A useful scope identifies the first outcome, the boundaries, the data sources, the handoffs, the risks and the acceptance criteria. Out-of-scope work stays out of scope until change control says otherwise.",[220],"[data-approved-section=\"1-paragraph-1\"]",{"_144":119,"_154":217},"Current-state map and scope","[data-approved-section=\"1-heading\"]","[data-approved-section=\"0\"]",[163],{"_159":160,"_119":233},[227,228],{"_144":138,"_117":118,"_159":160,"_119":233,"_133":234},{"_144":145,"_117":146,"_119":229,"_148":230,"_133":231},"No large build starts with a vague promise. It starts with a named problem, the current workflow, the systems involved and the people who approve exceptions.",[232],"[data-approved-section=\"0-paragraph-1\"]",{"_144":119,"_154":229},"Discovery and qualification","[data-approved-section=\"0-heading\"]",{"_117":118,"_159":146,"_119":33},{"_117":146,"_159":160,"_119":233},{"_117":160,"_159":160,"_119":233},{"_117":164,"_159":160,"_119":221},{"_117":132,"_159":160,"_119":221},{"_117":251,"_159":160,"_119":209},{"_117":250,"_159":160,"_119":209},{"_117":249,"_159":160,"_119":180},{"_117":248,"_159":160,"_119":180},{"_117":247,"_159":160,"_119":161},{"_117":246,"_159":160,"_119":161},10,9,8,7,6,5,{"_117":118,"_253":254,"_255":256,"_257":258},"types",[79,80],"rawJson","{\n  \"approvedRoute\": \"/how-we-work\",\n  \"description\": \"See how Silverstone defines, designs, builds and reviews websites, apps and AI workflows for UK businesses.\",\n  \"name\": \"How Silverstone Works | Discovery to Delivery\",\n  \"note\": \"Approved editorial overlay for H-01/H-03/H-04 implementation.\",\n  \"types\": [\n    \"WebPage\",\n    \"BreadcrumbList\"\n  ],\n  \"url\": \"https://silverstone-ai.com/how-we-work\"\n}","parsed",{"_259":14,"_30":31,"_83":29,"_253":254,"_260":16},"approvedRoute","url","robots","noindex,nofollow,noarchive","author","openGraph",[281,282,283,284,285],"twitter",[274,275,276],"other",[270],{"_271":272,"_5":273},"key","viewport","width=device-width, initial-scale=1.0, viewport-fit=cover",{"_83":279,"_5":280},{"_83":278,"_5":29},{"_83":277,"_5":31},"twitter:description","twitter:title","twitter:card","summary",{"_286":292,"_5":293},{"_286":29