eading",{"_182":153,"_169":183},"blocks",[163,164,165],{"_166":159,"_152":181,"_182":153,"_169":183,"_154":184},{"_166":167,"_152":176,"_169":177,"_171":178,"_154":179},{"_166":167,"_152":168,"_169":170,"_171":172,"_154":173},"type","paragraph",25,"text","Book the Free Audit","segments",[174],"a.btn.btn-primary",{"_166":169,"_175":170},"value",24,"Book the audit if you want a practical view of what to automate first.",[180],"p.section-subtitle",{"_166":169,"_175":177},23,"level","Ready to build smarter systems?","h2.section-title","section","brand-gradient","animate",1,"section.section.bg-mesh.animate",[185,278,187,279],{"_182":153,"_169":277},[193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213],{"_166":159,"_152":153,"_182":153,"_169":277,"_154":184},{"_166":167,"_152":272,"_169":273,"_171":274,"_154":275},{"_166":167,"_152":248,"_169":269,"_171":270,"_154":229},{"_166":159,"_152":267,"_182":153,"_169":268,"_154":184},{"_166":167,"_152":263,"_169":264,"_171":265,"_154":179},{"_166":159,"_152":261,"_182":248,"_169":262,"_154":250},{"_166":167,"_152":257,"_169":258,"_171":259,"_154":229},{"_166":159,"_152":255,"_182":248,"_169":256,"_154":250},{"_166":167,"_152":251,"_169":252,"_171":253,"_154":229},{"_166":159,"_152":247,"_182":248,"_169":249,"_154":250},{"_166":167,"_152":243,"_169":244,"_171":245,"_154":229},{"_166":159,"_152":241,"_182":153,"_169":242,"_154":184},{"_166":167,"_152":237,"_169":238,"_171":239,"_154":179},{"_166":159,"_152":235,"_182":153,"_169":236,"_154":184},{"_166":167,"_152":231,"_169":232,"_171":233,"_154":229},{"_166":167,"_152":226,"_169":227,"_171":228,"_154":229},{"_166":159,"_152":224,"_182":153,"_169":225,"_154":184},{"_166":167,"_152":220,"_169":221,"_171":222,"_154":179},{"_166":214,"_152":219,"_216":143,"_154":217},{"_166":214,"_152":218,"_216":137,"_154":217},{"_166":214,"_152":215,"_216":116,"_154":217},"image",22,"assetId","img",21,20,19,"Technology is only useful when it creates clearer operations and better outcomes for people.",[223],{"_166":169,"_175":221},18,"What Drives Us",17,"Today, we partner closely with clients across industries - from professional services and manufacturing to retail and healthcare - to identify bottlenecks, remove friction and implement smart systems that work seamlessly together. Our bespoke approach ensures that every solution fits your business like a glove, delivering measurable results and empowering your people.",[230],"p",{"_166":169,"_175":227},16,"Founded by a team of technologists and entrepreneurs, Silverstone AI was born out of a desire to help small businesses harness the power of automation without the complexity. We saw how inefficient processes, manual tasks and disconnected systems were holding organisations back and decided to build a better way.",[234],{"_166":169,"_175":232},15,"Our Story",14,"A snapshot of our impact so far.",[240],{"_166":169,"_175":238},13,"Experience by the Numbers",12,"Automation should remove low-value work so people can focus on judgment, service, and growth.",[246],{"_166":169,"_175":244},11,4,"Empowering People","h4",10,"We use modern tools carefully, with a bias for clear outcomes over novelty.",[254],{"_166":169,"_175":252},9,"Innovation & Excellence",8,"We listen first, then design around the way your business actually works.",[260],{"_166":169,"_175":258},7,"Personalised Approach",6,"The principles that guide every project and partnership.",[266],{"_166":169,"_175":264},5,"Our Values","Our mission is to replace scattered manual tasks with a calmer operating rhythm: faster first response, cleaner handoffs, fewer dropped opportunities, and more time for the work only your team should own. The result is premium in feel but practical in delivery, giving ambitious businesses a stronger foundation for sustainable growth.",[271],{"_166":169,"_175":269},3,"Silverstone AI helps UK small businesses run with the clarity, consistency, and commercial control of a much larger team. We design practical automation around the way your people already work, so every workflow feels measured, brand-safe, and immediately useful rather than bolted on for the sake of novelty.",[276],"p.mission-card__lead",{"_166":169,"_175":273},"Our Mission","bg-mesh","parallax-section",0,"section.hero.title-band",[294,295],{"_182":188,"_169":33},[285,286],{"_166":167,"_152":280,"_169":290,"_171":291,"_154":292},{"_166":167,"_152":188,"_169":287,"_171":288,"_154":229},"Silverstone AI is a London automation studio helping UK small businesses save time, cut admin, and run on better systems.",[289],{"_166":169,"_175":287},"HOME",[293],"a.hero-breadcrumb__link",{"_166":169,"_175":290},"hero","title-band",{"_152":280,"_182":188,"_169":33},{"_152":188,"_182":153,"_169":277},{"_152":153,"_182":153,"_169":268},{"_152":272,"_182":248,"_169":262},{"_152":248,"_182":248,"_169":256},{"_152":267,"_182":248,"_169":249},{"_152":263,"_182":153,"_169":242},{"_152":261,"_182":153,"_169":236},{"_152":257,"_182":153,"_169":225},{"_152":255,"_182":153,"_169":183},{"_152":280,"_307":308,"_309":310,"_311":312},"types",[330,77,326],"rawJson","{\n      \"@context\": \"https://schema.org\",\n      \"@graph\": [\n        {\n          \"@type\": \"AboutPage\",\n          \"@id\": \"https://silverstone-ai.com/about#webpage\",\n          \"url\": \"https://silverstone-ai.com/about\",\n          \"name\": \"About Silverstone AI - Silverstone AI\",\n          \"description\": \"Learn how Silverstone AI helps UK small businesses grow with practical automation, faster response times, and tailored support.\",\n          \"isPartOf\": {\n            \"@id\": \"https://silverstone-ai.com/#website\"\n          },\n          \"about\": {\n            \"@id\": \"https://silverstone-ai.com/#organization\"\n          },\n          \"breadcrumb\": {\n            \"@id\": \"https://silverstone-ai.com/about#breadcrumb\"\n          }\n        },\n        {\n          \"@type\": \"BreadcrumbList\",\n          \"@id\": \"https:/