# Staging baseline contracts
VITE_STAGING_MODE=true
VITE_ANALYTICS_DISABLED=true
VITE_ROBOTS_META=noindex,nofollow,noarchive
VITE_X_ROBOTS_TAG=noindex,nofollow,noarchive
RESEND_MODE=mock
VITE_BOOKING_MODE=mock
CALENDLY_BOOKING_MODE=mock

# Dev-server-only (web/.env.staging.local): "live" points the booking console
# at the real Calendly pipeline through the dev functions bridge (token from
# the repository-root .env). Ignored by every build.
# VITE_DEV_BOOKING_MODE=live

# Public URL placeholders for local and preview wiring
VITE_SITE_URL=https://staging.example.invalid
VITE_CANONICAL_ORIGIN=https://staging.example.invalid

# Explicitly blank placeholders. Do not commit secrets here.
# Calendly values are server-only. Never prefix them with VITE_.
# Replace the placeholder with a real Personal Access Token in a gitignored
# local env file (repository-root .env for `netlify dev`) or in the Netlify
# site environment settings for production — never in a committed file.
CALENDLY_API_TOKEN=PASTE_YOUR_CALENDLY_API_TOKEN_HERE
CALENDLY_EVENT_TYPE_URI=
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
CONTACT_EMAIL=
GA_MEASUREMENT_ID=
GTM_ID=
SENTRY_DSN=
POSTHOG_KEY=
PLAUSIBLE_DOMAIN=
MIXPANEL_TOKEN=
HOTJAR_ID=
CLARITY_ID=
