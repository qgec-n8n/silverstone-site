{
  "name": "silverstone-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "dev": "react-router dev --mode staging --host 0.0.0.0",
    "build": "react-router build --mode staging",
    "preview": "node --env-file=.env.staging scripts/preview.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint src tests scripts *.config.ts --max-warnings=0",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,js,mjs,css}\" \"scripts/{preview,report-bundle}.mjs\" \"*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,js,mjs,css}\" \"scripts/{preview,report-bundle}.mjs\" \"*.{ts,js,mjs,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "bundle:report": "node scripts/report-bundle.mjs",
    "migration:validate": "node scripts/migration/validate-migrated-content.mjs",
    "staging:safety": "node --env-file=.env.staging scripts/assert-staging-safety.mjs --scan build/client --scan public",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle:report && npm run staging:safety && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@paper-design/shaders-react": "^0.0.76",
    "@react-router/node": "7.18.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "isbot": "^5",
    "lenis": "^1.3.23",
    "lucide-react": "^0.468.0",
    "maath": "^0.10.8",
    "postprocessing": "^6.39.1",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.18.0",
    "simple-icons": "^16.24.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.0",
    "@react-router/dev": "7.18.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.2",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
